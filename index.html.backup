<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flight Globe</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background: #000000;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: #ffffff;
        }

        #globe-container {
            width: 100%;
            height: 100%;
            transition: opacity 0.5s ease;
        }

        #loading {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #666;
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
            z-index: 10;
        }

        /* ============ START JOURNEY BUTTON ============ */
        #start-journey-btn {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            background: #ffffff;
            color: #000000;
            border: none;
            border-radius: 50px;
            padding: 20px 80px;
            font-size: 18px;
            font-weight: 500;
            cursor: pointer;
            z-index: 100;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(255, 255, 255, 0.2);
        }

        #start-journey-btn:hover {
            transform: translateX(-50%) scale(1.02);
            box-shadow: 0 6px 30px rgba(255, 255, 255, 0.3);
        }

        /* ============ MENU BUTTON ============ */
        #menu-btn {
            position: fixed;
            bottom: 40px;
            right: 30px;
            background: transparent;
            border: none;
            color: #ffffff;
            cursor: pointer;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
        }

        #menu-btn span {
            display: block;
            width: 24px;
            height: 2px;
            background: #ffffff;
        }

        .menu-label {
            font-size: 12px;
            color: #888;
            margin-top: 4px;
        }

        /* ============ CAMERA TOGGLE ============ */
        #camera-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(26, 26, 26, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #camera-toggle.active {
            background: #FFD700;
            color: #000;
        }

        #camera-toggle svg {
            width: 20px;
            height: 20px;
            fill: currentColor;
        }

        /* ============ WINDOW VIEW BUTTON ============ */
        #window-view-btn {
            position: fixed;
            top: 75px;
            right: 20px;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(26, 26, 26, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            z-index: 100;
            display: none;
            /* Hidden until in-flight */
            align-items: center;
            justify-content: center;
        }

        #window-view-btn:hover {
            background: rgba(40, 40, 40, 0.9);
        }

        #window-view-btn.active {
            background: #87CEEB;
            color: #000;
        }

        /* ============ WINDOW VIEW CONTAINER ============ */
        #window-view-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 600;
            display: none;
        }

        #window-view-container.active {
            display: block;
        }

        #window-scene {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        #window-scene canvas {
            width: 100% !important;
            height: 100% !important;
        }

        /* Airplane window frame - outer wall/fuselage */
        #window-frame {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 5;

            /* High Fidelity SVG Asset */
            background-image: url("assets/window_frame_transparent.png");
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
        }

        /* Removed old procedural frame elements as they are now in the SVG */
        #window-frame::after {
            content: none;
        }

        #window-inner-frame {
            display: none;
        }

        #window-close-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(40, 42, 48, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            z-index: 610;
            backdrop-filter: blur(10px);
        }

        #window-close-btn:hover {
            background: rgba(60, 62, 68, 0.95);
        }

        /* ============ CENTER BUTTON ============ */
        #center-btn {
            position: fixed;
            bottom: 100px;
            left: 20px;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(26, 26, 26, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        #center-btn:hover {
            background: rgba(40, 40, 40, 0.9);
        }

        /* In-flight position: top right below camera toggle */
        #center-btn.in-flight {
            bottom: auto;
            left: auto;
            top: 75px;
            right: 20px;
        }

        /* Hide center button when booking screen is active */
        #time-selector.active~#center-btn,
        .time-selector-active #center-btn {
            display: none !important;
        }

        /* ============ MENU PANEL ============ */
        #menu-panel {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #1a1a1a;
            border-radius: 24px 24px 0 0;
            z-index: 200;
            transform: translateY(100%);
            transition: transform 0.3s ease;
            max-height: 80vh;
            overflow-y: auto;
        }

        #menu-panel.active {
            transform: translateY(0);
        }

        .menu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px;
            border-bottom: 1px solid #333;
            position: sticky;
            top: 0;
            background: #1a1a1a;
        }

        .menu-header h2 {
            font-size: 18px;
            font-weight: 600;
        }

        .menu-close {
            background: none;
            border: none;
            color: #888;
            font-size: 24px;
            cursor: pointer;
            padding: 4px;
        }

        .menu-close svg {
            width: 24px;
            height: 24px;
            fill: currentColor;
        }

        /* Stats Section in Menu */
        .menu-stats {
            display: flex;
            justify-content: space-around;
            padding: 20px 16px;
            border-bottom: 1px solid #333;
            background: #1a1a1a;
        }

        .menu-stat {
            text-align: center;
        }

        .menu-stat .stat-value {
            font-size: 24px;
            font-weight: 600;
            color: #fff;
        }

        .menu-stat .stat-label {
            font-size: 11px;
            color: #666;
            text-transform: uppercase;
            margin-top: 4px;
        }

        /* Focus Type Selector */
        .focus-type-container {
            margin: 0 20px 15px;
            padding: 12px;
            background: rgba(26, 26, 26, 0.95);
            border-radius: 16px;
        }

        .focus-type-label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 10px;
            text-align: center;
        }

        .focus-types {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            scrollbar-width: none;
            padding: 4px;
        }

        .focus-types::-webkit-scrollbar {
            display: none;
        }

        .focus-type {
            flex-shrink: 0;
            padding: 10px 16px;
            background: #252525;
            border: none;
            border-radius: 20px;
            color: #888;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .focus-type.selected {
            background: #FFD700;
            color: #000;
        }

        .focus-type:hover:not(.selected) {
            background: #333;
            color: #fff;
        }

        /* Pomodoro Mode */
        .pomodoro-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 12px;
            padding: 8px 16px;
            background: #252525;
            border: none;
            border-radius: 20px;
            color: #888;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .pomodoro-toggle.active {
            background: #ef4444;
            color: #fff;
        }

        .pomodoro-display {
            display: none;
            position: fixed;
            top: 80px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            background: rgba(26, 26, 26, 0.95);
            border-radius: 12px;
            padding: 12px 20px;
            min-width: 200px;
        }

        .pomodoro-display.active {
            display: block;
        }

        .pomodoro-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .pomodoro-state {
            font-size: 14px;
            font-weight: 600;
        }

        .pomodoro-state.work {
            color: #ef4444;
        }

        .pomodoro-state.break {
            color: #22c55e;
        }

        .pomodoro-timer {
            font-size: 24px;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }

        .pomodoro-progress {
            height: 4px;
            background: #333;
            border-radius: 2px;
            overflow: hidden;
        }

        .pomodoro-progress-fill {
            height: 100%;
            background: #ef4444;
            transition: width 0.3s;
        }

        .pomodoro-progress-fill.break {
            background: #22c55e;
        }

        /* Settings Section in Menu */
        .menu-settings {
            padding: 16px 24px;
            border-top: 1px solid #333;
        }

        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
        }

        .setting-label {
            font-size: 14px;
            color: #ccc;
        }

        .unit-toggle {
            display: flex;
            background: #252525;
            border-radius: 20px;
            padding: 3px;
        }

        .unit-toggle button {
            padding: 6px 14px;
            border: none;
            border-radius: 17px;
            background: transparent;
            color: #888;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .unit-toggle button.active {
            background: #FFD700;
            color: #000;
        }

        .flight-history-list {
            padding: 16px;
        }

        .flight-history-empty {
            text-align: center;
            color: #666;
            padding: 40px 20px;
            font-size: 14px;
        }

        .history-item {
            background: #252525;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .history-item:hover {
            background: #303030;
        }

        .history-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .history-route {
            font-size: 18px;
            font-weight: 600;
        }

        .history-status {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 12px;
            text-transform: uppercase;
        }

        .history-status.completed {
            background: #22c55e;
            color: #fff;
        }

        .history-status.cancelled {
            background: #ef4444;
            color: #fff;
        }

        .history-details {
            display: flex;
            gap: 20px;
            font-size: 12px;
            color: #888;
        }

        /* User Location Marker */
        .user-location-marker {
            position: relative;
            width: 20px;
            height: 20px;
        }

        .user-location-marker .dot {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 12px;
            height: 12px;
            background: #4285f4;
            border-radius: 50%;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(66, 133, 244, 0.6);
            z-index: 2;
        }

        .user-location-marker .pulse {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 24px;
            height: 24px;
            background: rgba(66, 133, 244, 0.3);
            border-radius: 50%;
            animation: locationPulse 2s ease-out infinite;
        }

        @keyframes locationPulse {
            0% {
                transform: translate(-50%, -50%) scale(0.5);
                opacity: 1;
            }

            100% {
                transform: translate(-50%, -50%) scale(2.5);
                opacity: 0;
            }
        }

        /* ============ TURBULENCE EFFECTS ============ */
        @keyframes turbulenceShake {

            0%,
            100% {
                transform: translate(0, 0);
            }

            10% {
                transform: translate(-2px, -1px);
            }

            20% {
                transform: translate(2px, 2px);
            }

            30% {
                transform: translate(-1px, 2px);
            }

            40% {
                transform: translate(2px, -1px);
            }

            50% {
                transform: translate(-2px, 2px);
            }

            60% {
                transform: translate(2px, 1px);
            }

            70% {
                transform: translate(-1px, -2px);
            }

            80% {
                transform: translate(1px, 2px);
            }

            90% {
                transform: translate(-2px, -1px);
            }
        }

        #globe-container.turbulence {
            animation: turbulenceShake 0.15s ease-in-out infinite;
        }

        .turbulence-warning {
            position: fixed;
            top: 120px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(239, 68, 68, 0.9);
            color: #fff;
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            z-index: 400;
            display: none;
            animation: fadeInOut 0.3s ease-out;
        }

        .turbulence-warning.active {
            display: block;
        }

        @keyframes fadeInOut {
            0% {
                opacity: 0;
                transform: translateX(-50%) translateY(-10px);
            }

            100% {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        .menu-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 199;
            display: none;
        }

        .menu-overlay.active {
            display: block;
        }

        /* ============ TIME SELECTOR PANEL ============ */
        #time-selector {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 100;
            display: none;
            flex-direction: column;
            padding-bottom: 20px;
        }

        #time-selector.active {
            display: flex;
        }

        .time-slider-container {
            margin: 0 20px 15px;
            padding: 12px;
            background: rgba(26, 26, 26, 0.95);
            border-radius: 16px;
            overflow: hidden;
        }

        /* Hide destination pin when booking screen is open */
        #time-selector.active~#destination-pin-container,
        #time-selector.active+.destination-pin {
            display: none !important;
        }

        .time-slider {
            display: flex;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .time-slider::-webkit-scrollbar {
            display: none;
        }

        .time-option {
            flex-shrink: 0;
            padding: 15px 20px;
            color: #666;
            font-size: 14px;
            cursor: pointer;
            position: relative;
        }

        .time-option.selected {
            color: #ffffff;
        }

        .time-option.selected::before {
            content: '▼';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10px;
        }

        /* ============ DEPARTURE SELECTION ============ */
        .departure-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            margin: 0 20px 15px;
            background: rgba(26, 26, 26, 0.95);
            border-radius: 16px;
        }

        .departure-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .departure-label {
            font-size: 11px;
            color: #666;
            text-transform: uppercase;
        }

        .departure-value {
            font-size: 14px;
            font-weight: 600;
            color: #22c55e;
        }

        .change-departure-btn {
            background: #252525;
            border: none;
            padding: 8px 14px;
            border-radius: 16px;
            color: #888;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .change-departure-btn:hover {
            background: #333;
            color: #fff;
        }

        /* Departure Search Modal */
        .departure-modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.9);
            z-index: 300;
            display: none;
            flex-direction: column;
            padding: 20px;
        }

        .departure-modal.active {
            display: flex;
        }

        .departure-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .departure-modal-header h3 {
            font-size: 18px;
            font-weight: 600;
        }

        .departure-modal-close {
            background: none;
            border: none;
            color: #888;
            font-size: 24px;
            cursor: pointer;
        }

        .departure-search-input {
            width: 100%;
            padding: 14px 16px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 12px;
            color: #fff;
            font-size: 16px;
            margin-bottom: 16px;
        }

        .departure-search-input:focus {
            outline: none;
            border-color: #FFD700;
        }

        .departure-results {
            flex: 1;
            overflow-y: auto;
        }

        .departure-result-item {
            padding: 14px 16px;
            background: #1a1a1a;
            border-radius: 12px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .departure-result-item:hover {
            background: #252525;
        }

        .departure-result-item .code {
            font-weight: 600;
            color: #FFD700;
            margin-right: 10px;
        }

        .departure-result-item .name {
            color: #ccc;
        }

        .departure-result-item .city {
            font-size: 12px;
            color: #666;
            margin-top: 4px;
        }

        /* ============ SESSION NOTES MODAL ============ */
        .notes-modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.95);
            z-index: 350;
            display: none;
            flex-direction: column;
            padding: 20px;
        }

        .notes-modal.active {
            display: flex;
        }

        .notes-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .notes-modal-header h3 {
            font-size: 18px;
            font-weight: 600;
            color: #fff;
        }

        .notes-modal-close {
            background: none;
            border: none;
            color: #888;
            font-size: 28px;
            cursor: pointer;
            padding: 0;
            line-height: 1;
        }

        .notes-textarea {
            flex: 1;
            width: 100%;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 12px;
            color: #fff;
            font-size: 16px;
            padding: 16px;
            resize: none;
            font-family: inherit;
            line-height: 1.6;
        }

        .notes-textarea:focus {
            outline: none;
            border-color: #FFD700;
        }

        .notes-textarea::placeholder {
            color: #555;
        }

        .notes-save-hint {
            text-align: center;
            color: #666;
            font-size: 12px;
            margin-top: 12px;
        }

        /* Notes button in flight controls */
        .notes-btn {
            background: #252525;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .notes-btn:hover {
            background: #333;
        }

        /* ============ AIRPORT CARDS ============ */
        .airport-cards {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding: 10px 20px;
            scrollbar-width: none;
        }

        .airport-cards::-webkit-scrollbar {
            display: none;
        }

        /* Layover Destinations */
        .layover-container {
            display: none;
            margin: 0 20px 15px;
            padding: 12px;
            background: rgba(26, 26, 26, 0.95);
            border-radius: 16px;
        }

        .layover-container.active {
            display: block;
        }

        .layover-label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .layover-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .layover-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background: #252525;
            border-radius: 10px;
            font-size: 14px;
        }

        .layover-item .leg-number {
            color: #22c55e;
            font-weight: 600;
            margin-right: 8px;
        }

        .layover-item .airport-code {
            color: #fff;
            font-weight: 600;
        }

        .layover-item .airport-name {
            color: #888;
            font-size: 12px;
            margin-left: 8px;
        }

        .layover-item .remove-btn {
            background: none;
            border: none;
            color: #ef4444;
            font-size: 16px;
            cursor: pointer;
            padding: 4px;
        }

        .add-layover-btn {
            display: none;
            width: 100%;
            padding: 10px;
            margin-top: 8px;
            background: #252525;
            border: 2px dashed #444;
            border-radius: 10px;
            color: #888;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .add-layover-btn:hover {
            border-color: #22c55e;
            color: #22c55e;
        }

        .add-layover-btn.active {
            display: block;
        }

        .airport-card {
            flex-shrink: 0;
            background: #1a1a1a;
            border-radius: 16px;
            padding: 16px;
            min-width: 140px;
            cursor: pointer;
            border: 2px solid transparent;
        }

        .airport-card.selected {
            border-color: #ffffff;
        }

        .airport-card .code-btn {
            background: #FFD700;
            color: #000;
            border: none;
            border-radius: 12px;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-bottom: 12px;
        }

        .airport-card .city-name {
            color: #fff;
            font-size: 14px;
            text-align: center;
            margin-bottom: 4px;
        }

        .airport-card .flight-time {
            color: #666;
            font-size: 13px;
            text-align: center;
        }

        /* ============ POMODORO CONTAINER ============ */
        .pomodoro-container {
            display: flex;
            justify-content: center;
            margin: 0 20px 15px;
        }

        /* ============ SPLIT BOOK BUTTONS ============ */
        .book-buttons {
            display: flex;
            gap: 10px;
            margin: 20px;
        }

        .book-btn {
            flex: 1;
            background: #ffffff;
            color: #000;
            border: none;
            border-radius: 20px;
            padding: 16px 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .book-btn:disabled {
            background: #333;
            color: #666;
            cursor: not-allowed;
        }

        .book-btn:not(:disabled):hover {
            background: #22c55e;
            color: #fff;
        }

        /* ============ MULTI FLIGHT SCREEN ============ */
        #multi-flight-screen {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.95);
            z-index: 500;
            display: none;
            flex-direction: column;
            padding: 20px;
            overflow-y: auto;
        }

        #multi-flight-screen.active {
            display: flex;
        }

        .multi-flight-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .multi-flight-header h2 {
            font-size: 20px;
            font-weight: 600;
            color: #fff;
        }

        .multi-flight-close {
            background: none;
            border: none;
            color: #888;
            font-size: 24px;
            cursor: pointer;
        }

        .route-builder {
            background: #1a1a1a;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 20px;
        }

        .route-builder-label {
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .route-stop {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #252525;
            border-radius: 12px;
            margin-bottom: 8px;
        }

        .route-stop .stop-number {
            width: 28px;
            height: 28px;
            background: #22c55e;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }

        .route-stop .stop-info {
            flex: 1;
        }

        .route-stop .stop-code {
            font-weight: 600;
            font-size: 16px;
        }

        .route-stop .stop-name {
            font-size: 12px;
            color: #888;
        }

        .route-stop .remove-stop {
            background: none;
            border: none;
            color: #ef4444;
            font-size: 18px;
            cursor: pointer;
        }

        .layover-duration {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px;
            color: #888;
            font-size: 12px;
        }

        .layover-duration select {
            background: #333;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
        }

        .add-stop-btn {
            width: 100%;
            padding: 12px;
            background: #252525;
            border: 2px dashed #444;
            border-radius: 12px;
            color: #888;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .add-stop-btn:hover {
            border-color: #22c55e;
            color: #22c55e;
        }

        .multi-flight-time-options {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .multi-flight-time-options .time-option {
            padding: 8px 14px;
            background: #252525;
            border-radius: 16px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .multi-flight-time-options .time-option.selected {
            background: #fff;
            color: #000;
        }

        .multi-flight-time-options .time-option:hover:not(.selected) {
            background: #333;
        }

        .confirm-route-btn {
            background: #22c55e;
            color: #000;
            border: none;
            border-radius: 20px;
            padding: 16px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: auto;
        }

        .confirm-route-btn:disabled {
            background: #333;
            color: #666;
            cursor: not-allowed;
        }

        /* ============ BOARDING PASS ============ */
        #boarding-pass {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #1a1a1a;
            border-radius: 24px;
            width: 90%;
            max-width: 380px;
            z-index: 200;
            display: none;
        }

        #boarding-pass.active {
            display: block;
        }

        .pass-header {
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .pass-header .title {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #888;
        }

        .pass-header .flight-number {
            font-size: 14px;
            color: #666;
            margin-top: 4px;
        }

        .pass-header .now-badge {
            background: #22c55e;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 20px;
        }

        .pass-route {
            padding: 20px 24px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .pass-route .airport-code {
            font-size: 48px;
            font-weight: 700;
            line-height: 1;
        }

        .pass-route .airport-city {
            font-size: 13px;
            color: #666;
            margin-top: 8px;
            max-width: 150px;
        }

        .pass-route .plane-divider {
            font-size: 24px;
            color: #666;
        }

        .pass-divider {
            height: 1px;
            background: #333;
            margin: 0 24px;
        }

        .pass-details {
            padding: 24px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .pass-details .detail-item .label {
            font-size: 11px;
            color: #666;
            text-transform: uppercase;
        }

        .pass-details .detail-item .value {
            font-size: 20px;
            font-weight: 600;
            margin-top: 4px;
        }

        .pass-details-row {
            padding: 0 24px 24px;
            display: flex;
            justify-content: space-between;
        }

        .pass-barcode {
            padding: 20px 24px 30px;
            display: flex;
            justify-content: center;
        }

        .barcode-img {
            width: 200px;
            height: 60px;
            background: repeating-linear-gradient(90deg, #000 0px, #000 2px, #fff 2px, #fff 4px, #000 4px, #000 5px, #fff 5px, #fff 8px);
        }

        #checkin-btn {
            background: #ffffff;
            color: #000;
            border: none;
            border-radius: 50px;
            padding: 18px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            margin: 0 20px 30px;
            width: calc(100% - 40px);
        }

        /* ============ BOARDING PASS STYLES ============ */
        /* Style selector in time-selector */
        .style-selector {
            display: flex;
            gap: 8px;
            padding: 10px 20px;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .style-option {
            flex-shrink: 0;
            padding: 8px 14px;
            border-radius: 16px;
            border: 2px solid #333;
            background: #1a1a1a;
            color: #888;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .style-option.selected {
            border-color: #FFD700;
            color: #FFD700;
        }

        /* Inverted Style - White on Black */
        #boarding-pass.style-inverted {
            background: #000000;
            border: 1px solid #333;
        }

        #boarding-pass.style-inverted .pass-header .title,
        #boarding-pass.style-inverted .label {
            color: #888;
        }

        #boarding-pass.style-inverted .pass-header .flight-number,
        #boarding-pass.style-inverted .airport-city {
            color: #aaa;
        }

        #boarding-pass.style-inverted .airport-code,
        #boarding-pass.style-inverted .value {
            color: #ffffff;
        }

        #boarding-pass.style-inverted .now-badge {
            background: #ffffff;
            color: #000;
        }

        #boarding-pass.style-inverted .pass-divider {
            background: linear-gradient(90deg, transparent, #333 50%, transparent);
        }

        #boarding-pass.style-inverted .barcode-img {
            filter: invert(1);
        }

        #boarding-pass.style-inverted #checkin-btn {
            background: #ffffff;
            color: #000;
        }

        /* Minimal Style - Clean white */
        #boarding-pass.style-minimal {
            background: #ffffff;
            color: #1a1a1a;
        }

        #boarding-pass.style-minimal .pass-header .title,
        #boarding-pass.style-minimal .label {
            color: #888;
        }

        #boarding-pass.style-minimal .airport-code {
            color: #1a1a1a;
        }

        #boarding-pass.style-minimal .now-badge {
            background: #1a1a1a;
        }

        #boarding-pass.style-minimal .pass-divider {
            background: linear-gradient(90deg, transparent, #ddd 50%, transparent);
        }

        #boarding-pass.style-minimal #checkin-btn {
            background: #1a1a1a;
            color: #fff;
        }

        /* ============ IN-FLIGHT BAR ============ */
        #inflight-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(26, 26, 26, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 20px 20px 0 0;
            padding: 24px 40px;
            display: none;
            justify-content: space-between;
            z-index: 100;
        }

        #inflight-bar.active {
            display: flex;
        }

        .inflight-stat .label {
            font-size: 13px;
            color: #888;
        }

        .inflight-stat .value {
            font-size: 42px;
            font-weight: 300;
            margin-top: 4px;
        }

        .inflight-stat .unit {
            font-size: 18px;
            color: #888;
        }

        .inflight-controls {
            position: fixed;
            bottom: 140px;
            left: 50%;
            transform: translateX(-50%);
            display: none;
            gap: 12px;
            z-index: 100;
        }

        .inflight-controls.active {
            display: flex;
        }

        .inflight-controls button {
            background: rgba(26, 26, 26, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 20px;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
        }

        /* ============ TOOLTIP ============ */
        #airport-tooltip {
            position: fixed;
            background: rgba(26, 26, 26, 0.95);
            padding: 12px 16px;
            border-radius: 12px;
            color: #fff;
            pointer-events: none;
            z-index: 200;
            display: none;
        }

        #airport-tooltip .code {
            font-weight: 600;
            color: #FFD700;
            font-size: 16px;
        }

        /* ============ RESPONSIVE STYLES ============ */

        /* Use clamp for fluid typography */
        :root {
            --font-xs: clamp(10px, 2vw, 12px);
            --font-sm: clamp(11px, 2.5vw, 14px);
            --font-md: clamp(14px, 3vw, 18px);
            --font-lg: clamp(18px, 4vw, 24px);
            --font-xl: clamp(24px, 6vw, 42px);
            --font-xxl: clamp(32px, 8vw, 48px);
            --spacing-sm: clamp(8px, 2vw, 16px);
            --spacing-md: clamp(12px, 3vw, 24px);
            --spacing-lg: clamp(16px, 4vw, 40px);
        }

        /* Mobile-first adjustments */
        @media (max-width: 768px) {
            #start-journey-btn {
                padding: 16px 50px;
                font-size: var(--font-md);
                bottom: 30px;
            }

            #menu-btn {
                bottom: 30px;
                right: 20px;
            }

            #menu-btn span {
                width: 20px;
            }

            .menu-label {
                font-size: 10px;
            }

            #camera-toggle {
                width: 36px;
                height: 36px;
                font-size: 14px;
                top: 15px;
                right: 15px;
            }

            .time-slider-container {
                margin: 0 10px 15px;
                padding: 15px 0;
                border-radius: 16px;
            }

            .time-option {
                padding: 10px 14px;
                font-size: var(--font-sm);
            }

            .airport-cards {
                padding: 8px 10px;
                gap: 8px;
            }

            .airport-card {
                min-width: 110px;
                padding: 12px;
                border-radius: 12px;
            }

            .airport-card .code-btn {
                padding: 8px 12px;
                font-size: var(--font-sm);
                border-radius: 10px;
                margin-bottom: 8px;
            }

            .airport-card .city-name {
                font-size: var(--font-sm);
            }

            .airport-card .flight-time {
                font-size: var(--font-xs);
            }

            #book-my-flight-btn {
                padding: 14px 30px;
                font-size: var(--font-sm);
                margin: 15px 10px;
            }

            /* Boarding Pass Mobile */
            #boarding-pass {
                width: 95%;
                max-width: 340px;
                border-radius: 20px;
            }

            .pass-header {
                padding: 16px 20px;
            }

            .pass-header .title {
                font-size: 10px;
            }

            .pass-header .flight-number {
                font-size: 12px;
            }

            .pass-header .now-badge {
                font-size: 10px;
                padding: 5px 12px;
            }

            .pass-route {
                padding: 16px 20px 24px;
            }

            .pass-route .airport-code {
                font-size: var(--font-xxl);
            }

            .pass-route .airport-city {
                font-size: var(--font-xs);
                max-width: 120px;
            }

            .pass-route .plane-divider {
                font-size: 20px;
            }

            .pass-divider {
                margin: 0 20px;
            }

            .pass-details {
                padding: 16px 20px;
                gap: 12px;
            }

            .pass-details .detail-item .label {
                font-size: 9px;
            }

            .pass-details .detail-item .value {
                font-size: var(--font-md);
            }

            .pass-details-row {
                padding: 0 20px 16px;
            }

            .pass-barcode {
                padding: 16px 20px 24px;
            }

            .barcode-img {
                width: 160px;
                height: 50px;
            }

            #checkin-btn {
                padding: 14px;
                font-size: var(--font-sm);
                margin: 0 16px 24px;
                width: calc(100% - 32px);
            }

            /* In-Flight Bar Mobile */
            #inflight-bar {
                padding: 16px 20px;
                border-radius: 16px 16px 0 0;
            }

            .inflight-stat .label {
                font-size: var(--font-xs);
            }

            .inflight-stat .value {
                font-size: var(--font-xl);
            }

            .inflight-stat .unit {
                font-size: var(--font-sm);
            }

            .inflight-controls {
                bottom: 100px;
                gap: 8px;
            }

            .inflight-controls button {
                padding: 10px 16px;
                font-size: var(--font-sm);
                border-radius: 10px;
            }
        }

        /* Extra small screens */
        @media (max-width: 400px) {
            #start-journey-btn {
                padding: 14px 40px;
                font-size: 14px;
            }

            .airport-card {
                min-width: 100px;
                padding: 10px;
            }

            .airport-card .code-btn {
                padding: 6px 10px;
                font-size: 12px;
            }

            .pass-route .airport-code {
                font-size: 36px;
            }

            .inflight-stat .value {
                font-size: 32px;
            }
        }

        /* ============ HIDE OLD UI ============ */
        #flight-panel,
        #ticket-panel,
        #flight-overlay,
        #flight-controls-overlay {
            display: none !important;
        }

        #flight-panel {
            position: fixed;
            top: 20px;
            left: 20px;
            background: rgba(20, 20, 30, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px;
            width: 320px;
            z-index: 100;
            color: #fff;
        }

        #flight-panel h2 {
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 16px;
            color: #888;
        }

        #search-airports {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

        #search-airports:focus {
            border-color: #3b82f6;
        }

        #search-airports::placeholder {
            color: #666;
        }

        #search-results {
            max-height: 200px;
            overflow-y: auto;
            margin-top: 8px;
            display: none;
        }

        .search-result {
            padding: 10px 12px;
            cursor: pointer;
            border-radius: 6px;
            transition: background 0.2s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .search-result:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .search-result .airport-code {
            font-weight: 600;
            color: #3b82f6;
        }

        .search-result .airport-name {
            font-size: 12px;
            color: #888;
            margin-left: 8px;
        }

        #selected-airports {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .airport-selection {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }

        .airport-selection .label {
            font-size: 12px;
            color: #666;
            width: 50px;
        }

        .airport-selection .value {
            flex: 1;
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            font-size: 14px;
        }

        .airport-selection .value.departure {
            border-left: 3px solid #22c55e;
        }

        .airport-selection .value.arrival {
            border-left: 3px solid #ef4444;
        }

        .airport-selection .clear-btn {
            background: none;
            border: none;
            color: #666;
            cursor: pointer;
            padding: 4px 8px;
            margin-left: 8px;
        }

        .airport-selection .clear-btn:hover {
            color: #fff;
        }

        #start-flight {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 16px;
            transition: opacity 0.2s, transform 0.2s;
        }

        #start-flight:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        #start-flight:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        #flight-info {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            display: none;
        }

        #flight-info .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 13px;
        }

        #flight-info .info-row .label {
            color: #666;
        }

        #flight-info .info-row .value {
            color: #fff;
            font-weight: 500;
        }

        #flight-controls {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        #flight-controls button {
            flex: 1;
            padding: 10px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            color: #fff;
            cursor: pointer;
            transition: background 0.2s;
        }

        #flight-controls button:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        #flight-controls button.active {
            background: #3b82f6;
            border-color: #3b82f6;
        }

        /* Progress bar */
        #progress-bar {
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            margin-top: 12px;
            overflow: hidden;
        }

        #progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #22c55e, #3b82f6, #ef4444);
            width: 0%;
            transition: width 0.1s linear;
        }

        /* Airport tooltip */
        #airport-tooltip {
            position: fixed;
            background: rgba(20, 20, 30, 0.95);
            backdrop-filter: blur(10px);
            padding: 12px 16px;
            border-radius: 8px;
            color: #fff;
            font-size: 13px;
            pointer-events: none;
            z-index: 200;
            display: none;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        #airport-tooltip .code {
            font-weight: 600;
            color: #3b82f6;
            font-size: 16px;
        }

        #airport-tooltip .name {
            color: #fff;
            margin-top: 4px;
        }

        #airport-tooltip .location {
            color: #666;
            font-size: 12px;
            margin-top: 2px;
        }

        /* Camera toggle button */
        #camera-toggle {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(20, 20, 30, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 20px;
            cursor: pointer;
            z-index: 100;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #camera-toggle:hover {
            background: rgba(59, 130, 246, 0.8);
            border-color: #3b82f6;
            transform: scale(1.05);
        }

        #camera-toggle.active {
            background: #3b82f6;
            border-color: #60a5fa;
        }

        /* ============ TICKET PANEL (Bottom Pull-Up) ============ */
        #ticket-panel {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 500px;
            z-index: 150;
            display: flex;
            flex-direction: column;
        }

        #ticket-panel.collapsed #ticket-content {
            max-height: 0;
            padding: 0 20px;
            opacity: 0;
            overflow: hidden;
        }

        #ticket-handle {
            background: linear-gradient(135deg, rgba(30, 30, 45, 0.95), rgba(20, 20, 35, 0.98));
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-bottom: none;
            border-radius: 16px 16px 0 0;
            padding: 12px 24px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.2s;
            order: -1;
            /* Keep handle at top of flex container */
        }

        #ticket-handle:hover {
            background: linear-gradient(135deg, rgba(40, 40, 55, 0.95), rgba(30, 30, 45, 0.98));
        }

        #ticket-handle .chevron {
            transition: transform 0.3s;
            font-size: 12px;
            opacity: 0.6;
        }

        #ticket-panel:not(.collapsed) #ticket-handle .chevron {
            transform: rotate(180deg);
        }

        #ticket-content {
            background: linear-gradient(180deg, rgba(25, 25, 40, 0.98), rgba(15, 15, 30, 0.99));
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-top: none;
            border-radius: 0 0 0 0;
            padding: 20px;
            max-height: 600px;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                padding 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s;
        }

        /* Ticket Styling */
        .ticket {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        }

        .ticket-header {
            background: linear-gradient(90deg, #3b82f6, #2563eb);
            padding: 8px 16px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #fff;
            text-align: center;
        }

        .ticket-body {
            padding: 20px;
        }

        .route {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .route .airport {
            text-align: center;
            flex: 1;
        }

        .route .airport .code {
            font-size: 32px;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }

        .route .airport .city {
            font-size: 12px;
            color: #888;
            margin-top: 4px;
        }

        .route .flight-icon {
            font-size: 24px;
            padding: 0 15px;
            color: #60a5fa;
        }

        .flight-details {
            display: flex;
            gap: 20px;
            padding: 16px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .flight-details .detail {
            flex: 1;
            text-align: center;
        }

        .flight-details .detail .label {
            font-size: 10px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .flight-details .detail .value {
            font-size: 18px;
            font-weight: 600;
            color: #fff;
            margin-top: 4px;
        }

        #ticket-search {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            outline: none;
            margin-bottom: 8px;
            transition: border-color 0.2s;
        }

        #ticket-search:focus {
            border-color: #3b82f6;
        }

        #ticket-search::placeholder {
            color: #666;
        }

        #ticket-results {
            max-height: 150px;
            overflow-y: auto;
            margin-bottom: 12px;
        }

        #ticket-results .result-item {
            padding: 10px 12px;
            cursor: pointer;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            transition: background 0.2s;
        }

        #ticket-results .result-item:hover {
            background: rgba(59, 130, 246, 0.2);
        }

        #ticket-results .result-item .code {
            font-weight: 600;
            color: #60a5fa;
        }

        #ticket-results .result-item .name {
            font-size: 12px;
            color: #888;
            margin-left: 8px;
        }

        #book-flight {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        #book-flight:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(34, 197, 94, 0.4);
        }

        #book-flight:disabled {
            background: #444;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* Hide old flight panel when ticket panel is active */
        #flight-panel {
            display: none;
        }

        /* In-flight overlay info */
        #flight-overlay {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(20, 20, 30, 0.9);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 16px 24px;
            color: #fff;
            display: none;
            z-index: 100;
            text-align: center;
        }

        #flight-overlay.active {
            display: block;
        }

        #flight-overlay .route-display {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        #flight-overlay .flight-stats {
            display: flex;
            gap: 24px;
            justify-content: center;
            font-size: 13px;
        }

        #flight-overlay .stat {
            text-align: center;
        }

        #flight-overlay .stat .label {
            color: #888;
            font-size: 10px;
            text-transform: uppercase;
        }

        #flight-overlay .stat .value {
            color: #60a5fa;
            font-weight: 600;
        }

        /* Flight controls during flight */
        #flight-controls-overlay {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: none;
            gap: 12px;
            z-index: 100;
        }

        #flight-controls-overlay.active {
            display: flex;
        }

        #flight-controls-overlay button {
            padding: 12px 24px;
            background: rgba(20, 20, 30, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        #flight-controls-overlay button:hover {
            background: rgba(59, 130, 246, 0.3);
            border-color: #3b82f6;
        }
    </style>
</head>

<body>
    <div id="loading">Loading Globe...</div>
    <div class="turbulence-warning" id="turbulence-warning">⚠️ Turbulence</div>
    <div id="globe-container"></div>

    <!-- Camera Toggle Button -->
    <button id="camera-toggle" title="Toggle camera mode: Free / Follow Plane">
        <span class="icon-camera">🌍</span>
        <span class="icon-target" style="display:none">✛</span>
    </button>

    <!-- Window View Toggle Button -->
    <button id="window-view-btn" title="Toggle window view">🪟</button>

    <!-- Window View Container -->
    <div id="window-view-container">
        <div id="window-scene"></div>
        <div id="window-frame"></div>
        <div id="window-inner-frame"></div>
        <button id="window-close-btn">✕</button>
    </div>

    <!-- Center Globe on User Location Button -->
    <button id="center-btn" title="Center on my location">📍</button>

    <!-- Start Journey Button (Initial State) -->
    <button id="start-journey-btn">Start Journey</button>

    <!-- Menu Button -->
    <button id="menu-btn">
        <span></span>
        <span></span>
        <span></span>
        <div class="menu-label">Menu</div>
    </button>

    <!-- Departure Search Modal -->
    <div class="departure-modal" id="departure-modal">
        <div class="departure-modal-header">
            <h3>Select Departure Airport</h3>
            <button class="departure-modal-close" id="departure-modal-close">×</button>
        </div>
        <input type="text" class="departure-search-input" id="departure-search-input" placeholder="Search airports...">
        <div class="departure-results" id="departure-results"></div>
    </div>

    <!-- Session Notes Modal -->
    <div class="notes-modal" id="notes-modal">
        <div class="notes-modal-header">
            <h3>📝 Flight Notes</h3>
            <button class="notes-modal-close" id="notes-modal-close">×</button>
        </div>
        <textarea class="notes-textarea" id="notes-textarea"
            placeholder="Write your notes here...&#10;&#10;Ideas, thoughts, tasks, or anything from your focus session."></textarea>
        <div class="notes-save-hint">Notes are saved automatically</div>
    </div>

    <!-- Menu Overlay -->
    <div class="menu-overlay" id="menu-overlay"></div>

    <!-- Menu Panel (Flight History) -->
    <div id="menu-panel">
        <div class="menu-header">
            <h2>Flight History</h2>
            <button class="menu-close" id="menu-close">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" fill="none" />
                </svg>
            </button>
        </div>
        <div class="menu-stats">
            <div class="menu-stat">
                <div class="stat-value" id="stat-total-distance">0</div>
                <div class="stat-label">Km Traveled</div>
            </div>
            <div class="menu-stat">
                <div class="stat-value" id="stat-airports-visited">0</div>
                <div class="stat-label">Airports</div>
            </div>
            <div class="menu-stat">
                <div class="stat-value" id="stat-flights-completed">0</div>
                <div class="stat-label">Completed</div>
            </div>
        </div>
        <div class="flight-history-list" id="flight-history-list">
            <div class="flight-history-empty">No flights yet. Start your first journey!</div>
        </div>
        <div class="menu-settings">
            <div class="setting-row">
                <span class="setting-label">Units</span>
                <div class="unit-toggle" id="unit-toggle">
                    <button class="active" data-unit="metric">Metric</button>
                    <button data-unit="imperial">Imperial</button>
                </div>
            </div>
            <div class="setting-row">
                <span class="setting-label">Pass Style</span>
                <div class="style-selector" id="style-selector">
                    <button class="style-option selected" data-style="classic">Original</button>
                    <button class="style-option" data-style="minimal">Minimal</button>
                    <button class="style-option" data-style="inverted">Inverted</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Time Selector Panel -->
    <div id="time-selector">
        <div class="departure-bar">
            <div class="departure-info">
                <span class="departure-label">From:</span>
                <span class="departure-value" id="departure-display">Detecting location...</span>
            </div>
            <button class="change-departure-btn" id="change-departure-btn">Change</button>
        </div>
        <div class="time-slider-container">
            <div class="time-slider">
                <div class="time-option" data-minutes="30">30m</div>
                <div class="time-option" data-minutes="40">40m</div>
                <div class="time-option" data-minutes="50">50m</div>
                <div class="time-option selected" data-minutes="60">1h</div>
                <div class="time-option" data-minutes="90">1h30m</div>
                <div class="time-option" data-minutes="120">2h</div>
                <div class="time-option" data-minutes="150">2h30m</div>
                <div class="time-option" data-minutes="180">3h</div>
                <div class="time-option" data-minutes="240">4h</div>
                <div class="time-option" data-minutes="300">5h</div>
                <div class="time-option" data-minutes="360">6h</div>
                <div class="time-option" data-minutes="420">7h</div>
                <div class="time-option" data-minutes="480">8h</div>
            </div>
        </div>
        <div class="focus-type-container">
            <div class="focus-type-label">Focus Mode</div>
            <div class="focus-types" id="focus-types">
                <button class="focus-type selected" data-type="Deep Work">🧠 Deep Work</button>
                <button class="focus-type" data-type="Reading">📖 Reading</button>
                <button class="focus-type" data-type="Study">🎓 Study</button>
                <button class="focus-type" data-type="Code">💻 Code</button>
                <button class="focus-type" data-type="Meditation">🧘 Meditation</button>
            </div>
        </div>
        <div class="airport-cards" id="airport-cards-list">
            <!-- Dynamically populated -->
        </div>
        <!-- Split Book Buttons -->
        <div class="book-buttons">
            <button id="book-single-btn" class="book-btn" disabled>Single Flight</button>
            <button id="book-multi-btn" class="book-btn" disabled>Multi Flight</button>
        </div>
    </div>

    <!-- Multi Flight Screen -->
    <div id="multi-flight-screen">
        <div class="multi-flight-header">
            <h2>✈️ Build Your Route</h2>
            <button class="multi-flight-close" id="multi-flight-close">✕</button>
        </div>
        <div class="route-builder" id="route-builder">
            <div class="route-builder-label">Your Route</div>
            <div id="route-stops">
                <!-- Populated dynamically -->
            </div>
            <button class="add-stop-btn" id="add-stop-btn">➕ Add Stop</button>
        </div>
        <!-- Flight time selector for next leg -->
        <div class="route-builder">
            <div class="route-builder-label">Flight Duration for Next Leg</div>
            <div class="multi-flight-time-options" id="multi-flight-time-options">
                <div class="time-option selected" data-minutes="30">30m</div>
                <div class="time-option" data-minutes="60">1h</div>
                <div class="time-option" data-minutes="90">1h30m</div>
                <div class="time-option" data-minutes="120">2h</div>
                <div class="time-option" data-minutes="180">3h</div>
                <div class="time-option" data-minutes="240">4h</div>
            </div>
        </div>
        <!-- Airport picker for adding stops -->
        <div class="route-builder">
            <div class="route-builder-label">Select Airport</div>
            <div class="airport-cards" id="multi-flight-airports">
                <!-- Populated dynamically -->
            </div>
        </div>
        <button class="confirm-route-btn" id="confirm-route-btn" disabled>✈️ Confirm Route & Book</button>
    </div>

    <!-- Boarding Pass -->
    <div id="boarding-pass">
        <div class="pass-header">
            <div>
                <div class="title">Boarding Pass</div>
                <div class="flight-number" id="pass-flight-number">Flight FF-2025</div>
            </div>
            <div class="now-badge">Now</div>
        </div>
        <div class="pass-route">
            <div class="departure-info">
                <div class="airport-code" id="pass-from-code">CDG</div>
                <div class="airport-city" id="pass-from-city">Paris</div>
            </div>
            <div class="plane-divider">✈️</div>
            <div class="arrival-info">
                <div class="airport-code" id="pass-to-code">JFK</div>
                <div class="airport-city" id="pass-to-city">New York</div>
            </div>
        </div>
        <div class="pass-divider"></div>
        <div class="pass-details">
            <div class="detail-item">
                <div class="label">Gate</div>
                <div class="value" id="pass-gate">A12</div>
            </div>
            <div class="detail-item">
                <div class="label">Seat</div>
                <div class="value" id="pass-seat">C5</div>
            </div>
            <div class="detail-item">
                <div class="label">Focus</div>
                <div class="value" id="pass-focus">Work</div>
            </div>
        </div>
        <div class="pass-details-row">
            <div class="detail-item">
                <div class="label">Distance</div>
                <div class="value" id="pass-distance">606Km</div>
            </div>
            <div class="detail-item">
                <div class="label">Date</div>
                <div class="value" id="pass-date">2026/01/11</div>
            </div>
        </div>
        <div class="pass-barcode">
            <div class="barcode-img"></div>
        </div>
        <button id="checkin-btn">Checking in</button>
    </div>

    <!-- In-Flight Status Bar -->
    <div id="inflight-bar">
        <div class="inflight-stat">
            <div class="label">Time Remaining</div>
            <div class="value"><span id="inflight-time">59</span> <span class="unit">min</span></div>
        </div>
        <div class="inflight-stat">
            <div class="label">Altitude</div>
            <div class="value"><span id="inflight-altitude">0</span> <span class="unit">ft</span></div>
        </div>
        <div class="inflight-stat">
            <div class="label">Distance Remaining</div>
            <div class="value"><span id="inflight-distance">605</span> <span class="unit">Km</span></div>
        </div>
    </div>

    <!-- In-Flight Controls -->
    <div class="inflight-controls" id="inflight-controls">
        <button id="pause-btn">⏸ Pause</button>
        <button class="notes-btn" id="notes-btn">📝 Notes</button>
        <button id="end-flight-btn">End Flight</button>
    </div>

    <!-- Flight Control Panel -->
    <div id="flight-panel">
        <h2>✈️ Flight Tracker</h2>
        <input type="text" id="search-airports" placeholder="Search airports (name, city, or code)...">
        <div id="search-results"></div>

        <div id="selected-airports">
            <div class="airport-selection">
                <span class="label">From</span>
                <div class="value departure" id="departure-display">Select departure</div>
                <button class="clear-btn" id="clear-departure">✕</button>
            </div>
            <div class="airport-selection">
                <span class="label">To</span>
                <div class="value arrival" id="arrival-display">Select arrival</div>
                <button class="clear-btn" id="clear-arrival">✕</button>
            </div>
        </div>

        <button id="start-flight" disabled>Start Flight</button>

        <div id="flight-info">
            <div class="info-row">
                <span class="label">Distance</span>
                <span class="value" id="distance-value">-</span>
            </div>
            <div class="info-row">
                <span class="label">Progress</span>
                <span class="value" id="progress-value">0%</span>
            </div>
            <div class="info-row">
                <span class="label">Altitude</span>
                <span class="value" id="altitude-value">-</span>
            </div>
            <div id="progress-bar">
                <div id="progress-fill"></div>
            </div>
            <div id="flight-controls">
                <button id="pause-flight">⏸ Pause</button>
                <button id="reset-flight">↺ Reset</button>
            </div>
        </div>
    </div>

    <!-- Airport Tooltip -->
    <div id="airport-tooltip">
        <div class="code"></div>
        <div class="name"></div>
        <div class="location"></div>
    </div>

    <!-- Ticket Panel (Bottom Pull-Up) -->
    <div id="ticket-panel" class="collapsed">
        <div id="ticket-handle">
            <span>✈️ Book a Focus Flight</span>
            <span class="chevron">▲</span>
        </div>
        <div id="ticket-content">
            <div class="ticket">
                <div class="ticket-header">Boarding Pass</div>
                <div class="ticket-body">
                    <div class="route">
                        <div class="airport from">
                            <div class="code" id="ticket-from-code">---</div>
                            <div class="city" id="ticket-from-city">Select departure</div>
                        </div>
                        <div class="flight-icon">✈️</div>
                        <div class="airport to">
                            <div class="code" id="ticket-to-code">---</div>
                            <div class="city" id="ticket-to-city">Select arrival</div>
                        </div>
                    </div>
                    <div class="flight-details">
                        <div class="detail">
                            <div class="label">Distance</div>
                            <div class="value" id="ticket-distance">---</div>
                        </div>
                        <div class="detail">
                            <div class="label">Focus Time</div>
                            <div class="value" id="ticket-duration">---</div>
                        </div>
                    </div>
                    <input type="text" id="ticket-search" placeholder="🔍 Search airports...">
                    <div id="ticket-results"></div>
                    <button id="book-flight" disabled>Book Flight & Board</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Pomodoro Timer Display (shown during flight if enabled) -->
    <div class="pomodoro-display" id="pomodoro-display">
        <div class="pomodoro-header">
            <span class="pomodoro-state work" id="pomodoro-state">🍅 WORK #1</span>
            <span class="pomodoro-timer" id="pomodoro-timer">25:00</span>
        </div>
        <div class="pomodoro-progress">
            <div class="pomodoro-progress-fill" id="pomodoro-progress-fill" style="width: 100%"></div>
        </div>
    </div>

    <!-- In-Flight Overlay (shown during flight) -->
    <div id="flight-overlay">
        <div class="route-display">
            <span id="overlay-from">---</span> → <span id="overlay-to">---</span>
        </div>
        <div class="flight-stats">
            <div class="stat">
                <div class="label">Progress</div>
                <div class="value" id="overlay-progress">0%</div>
            </div>
            <div class="stat">
                <div class="label">Time Left</div>
                <div class="value" id="overlay-time">---</div>
            </div>
            <div class="stat">
                <div class="label">Altitude</div>
                <div class="value" id="overlay-altitude">---</div>
            </div>
        </div>
    </div>

    <!-- Flight Controls (shown during flight) -->
    <div id="flight-controls-overlay">
        <button id="pause-flight-new">⏸ Pause</button>
        <button id="reset-flight-new">↺ End Flight</button>
    </div>

    <!-- Import map for Three.js modules -->
    <script type="importmap">
    {
        "imports": {
            "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
        }
    }
    </script>

    <script src="https://unpkg.com/globe.gl@2.27.0/dist/globe.gl.min.js"></script>
    <script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>

    <script>
        // ============ GLOBAL STATE ============
        let allAirports = [];
        let filteredAirports = [];
        let departureAirport = null;
        let arrivalAirport = null;
        let layoverAirports = []; // Array of intermediate stops
        let pendingLayover = false; // Whether we're adding a layover
        const MAX_LAYOVERS = 2; // Maximum 2 layovers (3 total legs)
        let flightInProgress = false;
        let flightPaused = false;
        let flightProgress = 0;
        let airplane = null;
        let animationId = null;

        const container = document.getElementById('globe-container');

        // ============ GLOBE SETUP ============
        const globe = Globe()
            .globeImageUrl(null)
            .backgroundColor('rgba(0,0,0,0)')
            .showAtmosphere(true)
            .atmosphereColor('#3a8bff')
            .atmosphereAltitude(0.15)
            .width(window.innerWidth)
            .height(window.innerHeight)
            // Airport markers
            .pointLat(d => d.lat)
            .pointLng(d => d.lon)
            .pointColor(d => {
                if (d === departureAirport) return '#22c55e';
                if (d === arrivalAirport) return '#ef4444';
                return 'rgba(255, 255, 255, 0.8)';
            })
            .pointAltitude(0.005)
            .pointRadius(d => {
                if (d === departureAirport || d === arrivalAirport) return 0.4;
                return d.iata ? 0.15 : 0.08;
            })
            .pointLabel(d => '')
            .onPointClick(handleAirportClick)
            .onPointHover(handleAirportHover)
            // Flight path arcs (trail behind plane - flat on surface)
            .arcColor(() => 'rgba(59, 130, 246, 0.6)')
            .arcAltitude(0)  // Flat on globe surface
            .arcAltitudeAutoScale(0)
            .arcDashLength(1)  // Solid line
            .arcDashGap(0)
            .arcDashAnimateTime(0)  // No animation
            .arcStroke(1)
            .arcsTransitionDuration(0)
            // User location marker
            .htmlElementsData([])
            .htmlLat(d => d.lat)
            .htmlLng(d => d.lng)
            .htmlElement(d => {
                const el = document.createElement('div');
                el.className = 'user-location-marker';
                el.innerHTML = '<div class="pulse"></div><div class="dot"></div>';
                return el;
            })
            .htmlAltitude(0.01);

        globe(container);

        // Access Three.js components
        const scene = globe.scene();
        const camera = globe.camera();
        const renderer = globe.renderer();
        const globeMaterial = globe.globeMaterial();

        // Make globe black
        globeMaterial.color.set(0x000000);
        globeMaterial.emissive.set(0x000000);

        // Controls
        const controls = globe.controls();
        controls.rotateSpeed = 0.25;
        controls.zoomSpeed = 0.5;
        controls.enableDamping = true;
        controls.dampingFactor = 0.1;
        controls.enablePan = true; // Enable panning (right-click drag or shift+drag)
        controls.panSpeed = 0.5;

        // ============ CAMERA MODE ============
        let cameraMode = 'free'; // 'free' or 'plane'
        const cameraToggleBtn = document.getElementById('camera-toggle');
        const defaultMinDistance = controls.minDistance || 101;
        const iconCamera = cameraToggleBtn.querySelector('.icon-camera');
        const iconTarget = cameraToggleBtn.querySelector('.icon-target');

        cameraToggleBtn.addEventListener('click', () => {
            cameraMode = cameraMode === 'free' ? 'plane' : 'free';
            cameraToggleBtn.classList.toggle('active', cameraMode === 'plane');

            // Toggle SVG icons
            if (cameraMode === 'plane') {
                iconCamera.style.display = 'none';
                iconTarget.style.display = 'block';
            } else {
                iconCamera.style.display = 'block';
                iconTarget.style.display = 'none';
            }

            cameraToggleBtn.title = cameraMode === 'plane'
                ? 'Camera: Following Plane (click to switch to Free)'
                : 'Camera: Free (click to follow plane)';

            // Adjust zoom limits based on mode
            if (cameraMode === 'plane') {
                controls.minDistance = 5;  // Allow much closer zoom
            } else {
                controls.minDistance = defaultMinDistance;  // Restore normal limit
            }
        });

        // ============ CENTER BUTTON ============
        const centerBtn = document.getElementById('center-btn');
        centerBtn?.addEventListener('click', () => {
            if (userLocation) {
                globe.pointOfView({ lat: userLocation.lat, lng: userLocation.lon, altitude: 0.6 }, 1500);
            }
        });

        // Camera update function - called in animation loop
        function updateCameraFollow() {
            if (cameraMode === 'plane' && airplane && airplane.visible) {
                // Smoothly move camera target towards plane
                controls.target.lerp(airplane.position, 0.05);
                controls.update();
            }
        }

        // Set up camera animation loop
        function animateCamera() {
            updateCameraFollow();
            requestAnimationFrame(animateCamera);
        }
        animateCamera();

        // ============ STARFIELD ============
        function createStarfield() {
            const starCount = 2000;
            const starGeometry = new THREE.BufferGeometry();
            const positions = new Float32Array(starCount * 3);
            const colors = new Float32Array(starCount * 3);

            for (let i = 0; i < starCount; i++) {
                const radius = 800 + Math.random() * 400;
                const theta = Math.random() * Math.PI * 2;
                const phi = Math.acos(2 * Math.random() - 1);

                positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
                positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
                positions[i * 3 + 2] = radius * Math.cos(phi);

                const colorChoice = Math.random();
                if (colorChoice < 0.7) {
                    colors[i * 3] = 0.9 + Math.random() * 0.1;
                    colors[i * 3 + 1] = 0.9 + Math.random() * 0.1;
                    colors[i * 3 + 2] = 0.9 + Math.random() * 0.1;
                } else if (colorChoice < 0.85) {
                    colors[i * 3] = 0.7 + Math.random() * 0.2;
                    colors[i * 3 + 1] = 0.8 + Math.random() * 0.2;
                    colors[i * 3 + 2] = 1.0;
                } else {
                    colors[i * 3] = 1.0;
                    colors[i * 3 + 1] = 0.9 + Math.random() * 0.1;
                    colors[i * 3 + 2] = 0.6 + Math.random() * 0.2;
                }
            }

            starGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            starGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

            const starMaterial = new THREE.PointsMaterial({
                size: 1.5,
                vertexColors: true,
                transparent: true,
                opacity: 0.8
            });

            scene.add(new THREE.Points(starGeometry, starMaterial));
        }

        // ============ SUN ============
        function createSun() {
            const sunGroup = new THREE.Group();

            const sunGeometry = new THREE.SphereGeometry(30, 32, 32);
            const sunMaterial = new THREE.MeshBasicMaterial({ color: 0xffdd44 });
            sunGroup.add(new THREE.Mesh(sunGeometry, sunMaterial));

            const innerGlow = new THREE.Mesh(
                new THREE.SphereGeometry(35, 32, 32),
                new THREE.MeshBasicMaterial({ color: 0xffaa00, transparent: true, opacity: 0.4, side: THREE.BackSide })
            );
            sunGroup.add(innerGlow);

            const outerGlow = new THREE.Mesh(
                new THREE.SphereGeometry(50, 32, 32),
                new THREE.MeshBasicMaterial({ color: 0xff6600, transparent: true, opacity: 0.15, side: THREE.BackSide })
            );
            sunGroup.add(outerGlow);

            sunGroup.position.set(400, 250, -300);
            scene.add(sunGroup);
        }

        // ============ CLOUD LAYER ============
        let cloudMesh = null;
        function createClouds() {
            // Create a sphere slightly larger than the globe
            const cloudGeo = new THREE.SphereGeometry(101.5, 64, 64);

            // Load cloud texture
            const textureLoader = new THREE.TextureLoader();
            textureLoader.load(
                'https://raw.githubusercontent.com/mrdoob/three.js/dev/examples/textures/planets/earth_clouds_1024.png',
                (cloudTexture) => {
                    // Success - apply texture
                    const cloudMat = new THREE.MeshBasicMaterial({
                        map: cloudTexture,
                        transparent: true,
                        opacity: 0.35,
                        depthWrite: false,
                        side: THREE.DoubleSide
                    });
                    cloudMesh = new THREE.Mesh(cloudGeo, cloudMat);
                    scene.add(cloudMesh);
                    console.log('Cloud layer loaded');

                    // Animate cloud rotation
                    function animateClouds() {
                        if (cloudMesh) {
                            cloudMesh.rotation.y += 0.00008; // Very slow rotation
                        }
                        requestAnimationFrame(animateClouds);
                    }
                    animateClouds();
                },
                undefined,
                (error) => {
                    // Fallback - create procedural clouds
                    console.warn('Cloud texture failed to load, creating procedural clouds');
                    const cloudMat = new THREE.MeshBasicMaterial({
                        color: 0xffffff,
                        transparent: true,
                        opacity: 0.15,
                        wireframe: false
                    });
                    cloudMesh = new THREE.Mesh(cloudGeo, cloudMat);
                    scene.add(cloudMesh);
                }
            );
        }
        // ============ 3D DESTINATION PIN ============
        let destinationPin = null;

        function createDestinationPin() {
            const group = new THREE.Group();

            // Pin sphere (top part)
            const sphereGeometry = new THREE.SphereGeometry(0.8, 16, 12);
            const pinMaterial = new THREE.MeshBasicMaterial({
                color: 0xea4335, // Google Maps red
                transparent: true,
                opacity: 0.95
            });
            const sphere = new THREE.Mesh(sphereGeometry, pinMaterial);
            sphere.position.y = 2.5;
            group.add(sphere);

            // Pin needle (tapered cone pointing down)
            const coneGeometry = new THREE.ConeGeometry(0.6, 2, 16);
            const cone = new THREE.Mesh(coneGeometry, pinMaterial);
            cone.position.y = 1;
            cone.rotation.x = Math.PI; // Point downward
            group.add(cone);

            // Inner white dot on sphere
            const dotGeometry = new THREE.CircleGeometry(0.35, 16);
            const dotMaterial = new THREE.MeshBasicMaterial({ color: 0xffffff });
            const dot = new THREE.Mesh(dotGeometry, dotMaterial);
            dot.position.set(0, 2.5, 0.81);
            group.add(dot);

            group.visible = false;
            group.scale.set(0.5, 0.5, 0.5);
            return group;
        }

        function showDestinationPin(airport) {
            if (!destinationPin || !airport) return;

            const lat = airport.lat * Math.PI / 180;
            const lng = airport.lon * Math.PI / 180;
            const radius = 101; // Slightly above globe

            destinationPin.position.set(
                radius * Math.cos(lat) * Math.sin(lng),
                radius * Math.sin(lat),
                radius * Math.cos(lat) * Math.cos(lng)
            );

            // Orient pin to stand upright on globe surface
            destinationPin.lookAt(0, 0, 0);
            destinationPin.rotateX(-Math.PI / 2);

            destinationPin.visible = true;
        }

        function hideDestinationPin() {
            if (destinationPin) destinationPin.visible = false;
        }

        // ============ 3D AIRPLANE ============
        async function createAirplane() {
            // Load custom C919 aircraft model
            const { FBXLoader } = await import('three/addons/loaders/FBXLoader.js');
            const loader = new FBXLoader();

            return new Promise((resolve) => {
                loader.load('C919.FBX', (fbx) => {
                    console.log('FBX loaded, analyzing meshes...');

                    // Collect ALL meshes with their vertex counts
                    const allMeshes = [];
                    fbx.traverse((child) => {
                        if (child.isMesh && child.geometry) {
                            const vertCount = child.geometry.attributes?.position?.count || 0;
                            const name = child.name.toLowerCase();
                            allMeshes.push({ mesh: child, name: child.name, nameLower: name, vertices: vertCount });
                        }
                    });

                    // Sort by vertex count (highest first)
                    allMeshes.sort((a, b) => b.vertices - a.vertices);

                    console.log('All meshes by vertex count:');
                    allMeshes.forEach((m, i) => {
                        console.log(`  ${i + 1}. "${m.name}" - ${m.vertices} vertices`);
                    });

                    // SMARTER FILTERING:
                    // 1. Remove objects with "engine", "nacelle", "turbine", "fan" in name
                    // 2. Keep everything else in top 10 meshes (to include vertical stabilizer)
                    const enginePatterns = ['engine', 'nacelle', 'turbine', 'fan', 'motor', 'prop', 'thrust'];

                    const meshesToKeep = new Set();
                    let keptCount = 0;
                    const maxKeep = 15; // Increased to include vertical stabilizer

                    for (const m of allMeshes) {
                        // Skip engines
                        const isEngine = enginePatterns.some(pattern => m.nameLower.includes(pattern));
                        if (isEngine) {
                            console.log(`  Skipping engine mesh: "${m.name}"`);
                            continue;
                        }

                        if (keptCount < maxKeep) {
                            meshesToKeep.add(m.mesh);
                            keptCount++;
                            console.log(`  Keeping mesh: "${m.name}" (${m.vertices} verts)`);
                        }
                    }

                    console.log(`Keeping ${meshesToKeep.size} meshes (excluding engines)`);

                    // Remove everything that's not in the whitelist
                    const toRemove = [];
                    fbx.traverse((child) => {
                        // Remove all lines and points
                        if (child.isLineSegments || child.isLine || child.isPoints) {
                            toRemove.push(child);
                            return;
                        }

                        if (child.isMesh) {
                            if (!meshesToKeep.has(child)) {
                                toRemove.push(child);
                            } else {
                                // Apply material to kept meshes
                                child.material = new THREE.MeshStandardMaterial({
                                    color: 0xffffff,
                                    metalness: 0.3,
                                    roughness: 0.5
                                });
                            }
                        }
                    });

                    // Remove all non-whitelisted objects
                    toRemove.forEach(obj => {
                        if (obj.parent) obj.parent.remove(obj);
                    });

                    console.log(`Removed ${toRemove.length} objects`);

                    // Create wrapper group - this is what we'll position on the flight path
                    const wrapper = new THREE.Group();

                    // Compute center of FBX bounding box
                    const box = new THREE.Box3().setFromObject(fbx);
                    const center = new THREE.Vector3();
                    box.getCenter(center);
                    console.log('FBX bounding box center:', center.x.toFixed(1), center.y.toFixed(1), center.z.toFixed(1));

                    // Offset the FBX inside the wrapper to center it
                    fbx.position.set(-center.x, -center.y, -center.z);
                    wrapper.add(fbx);

                    // Scale the wrapper
                    wrapper.scale.set(0.02, 0.02, 0.02);
                    wrapper.visible = false;

                    scene.add(wrapper);
                    console.log('C919 aircraft model ready (wrapper centered)');
                    resolve(wrapper);
                },
                    (progress) => {
                        if (progress.total > 0) {
                            console.log('Loading C919:', Math.round(progress.loaded / progress.total * 100) + '%');
                        }
                    },
                    (error) => {
                        console.error('Error loading C919:', error);
                        // Fallback to simple procedural plane
                        resolve(createFallbackPlane());
                    });
            });
        }

        // Fallback if FBX fails
        function createFallbackPlane() {
            const group = new THREE.Group();
            const mat = new THREE.MeshBasicMaterial({ color: 0xffffff });

            const body = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.08, 0.8, 12), mat);
            body.rotation.z = Math.PI / 2;
            group.add(body);

            const wings = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.02, 1.0), mat);
            group.add(wings);

            const tail = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.2, 0.02), mat);
            tail.position.set(-0.35, 0.1, 0);
            group.add(tail);

            group.scale.set(4.0, 4.0, 4.0);
            group.visible = false;
            scene.add(group);
            return group;
        }

        // ============ AIRPORT DATA ============
        async function loadAirports() {
            try {
                const response = await fetch('https://raw.githubusercontent.com/mwgg/Airports/master/airports.json');
                const data = await response.json();

                allAirports = Object.entries(data)
                    .map(([icao, airport]) => ({
                        icao,
                        iata: airport.iata || '',
                        name: airport.name,
                        city: airport.city,
                        country: airport.country,
                        lat: airport.lat,
                        lon: airport.lon,
                        elevation: airport.elevation
                    }))
                    .filter(a => a.lat && a.lon); // Filter out airports without coordinates

                console.log(`Loaded ${allAirports.length} airports`);

                // Find and set nearest airport to user
                findAndSetNearestAirport();

                updateVisibleAirports();
                document.getElementById('loading').style.display = 'none';
            } catch (err) {
                console.error('Failed to load airports:', err);
                document.getElementById('loading').textContent = 'Failed to load airport data';
            }
        }

        // Find nearest airport to user's location
        function findAndSetNearestAirport() {
            if (!userLocation || allAirports.length === 0) return;

            const sorted = allAirports
                .filter(a => a.iata) // Only major airports with IATA codes
                .map(a => ({
                    ...a,
                    distance: haversineDistance(userLocation.lat, userLocation.lon, a.lat, a.lon)
                }))
                .sort((a, b) => a.distance - b.distance);

            if (sorted.length > 0) {
                nearestAirport = sorted[0];
                updateDepartureDisplay();
                console.log('Nearest airport:', nearestAirport.iata, nearestAirport.city);
            }
        }

        // ============ LOD (Level of Detail) ============
        // PERFORMANCE: Only show top 500 major airports
        function updateVisibleAirports() {
            // Only show top 200 commercial airports with IATA codes
            const majorAirports = allAirports
                .filter(a => a.iata && a.iata.length > 0)
                .slice(0, 200); // Limit to 200 for better performance

            filteredAirports = [...majorAirports];

            // Always include selected airports even if they're not in top 500
            if (departureAirport && !filteredAirports.includes(departureAirport)) {
                filteredAirports.push(departureAirport);
            }
            if (arrivalAirport && !filteredAirports.includes(arrivalAirport)) {
                filteredAirports.push(arrivalAirport);
            }

            // Airport markers disabled (old icons removed)
            // globe.pointsData(filteredAirports);
        }

        // ============ AIRPORT SEARCH ============
        const searchInput = document.getElementById('search-airports');
        const searchResults = document.getElementById('search-results');

        searchInput.addEventListener('input', () => {
            const query = searchInput.value.toLowerCase().trim();

            if (query.length < 2) {
                searchResults.style.display = 'none';
                return;
            }

            const matches = allAirports
                .filter(a =>
                    a.iata?.toLowerCase().includes(query) ||
                    a.icao?.toLowerCase().includes(query) ||
                    a.name?.toLowerCase().includes(query) ||
                    a.city?.toLowerCase().includes(query)
                )
                .slice(0, 10);

            if (matches.length === 0) {
                searchResults.style.display = 'none';
                return;
            }

            searchResults.innerHTML = matches.map(airport => `
                <div class="search-result" data-icao="${airport.icao}">
                    <span>
                        <span class="airport-code">${airport.iata || airport.icao}</span>
                        <span class="airport-name">${airport.name}</span>
                    </span>
                    <span class="airport-name">${airport.city}, ${airport.country}</span>
                </div>
            `).join('');

            searchResults.style.display = 'block';

            // Add click handlers
            searchResults.querySelectorAll('.search-result').forEach(el => {
                el.addEventListener('click', () => {
                    const airport = allAirports.find(a => a.icao === el.dataset.icao);
                    if (airport) {
                        selectAirport(airport);
                        searchInput.value = '';
                        searchResults.style.display = 'none';
                    }
                });
            });
        });

        // ============ AIRPORT SELECTION ============
        function handleAirportClick(airport) {
            if (airport) selectAirport(airport);
        }

        function selectAirport(airport) {
            if (!departureAirport) {
                departureAirport = airport;
                document.getElementById('departure-display').textContent =
                    `${airport.iata || airport.icao} - ${airport.city}`;
            } else if (!arrivalAirport && airport !== departureAirport) {
                arrivalAirport = airport;
                document.getElementById('arrival-display').textContent =
                    `${airport.iata || airport.icao} - ${airport.city}`;
            }

            updateFlightUI();
            updateVisibleAirports();
            updateFlightPath();

            // Fly to the selected airport
            globe.pointOfView({
                lat: airport.lat,
                lng: airport.lon,
                altitude: 1.5
            }, 1000);
        }

        function handleAirportHover(airport) {
            const tooltip = document.getElementById('airport-tooltip');

            if (airport) {
                tooltip.querySelector('.code').textContent = airport.iata || airport.icao;
                tooltip.querySelector('.name').textContent = airport.name;
                tooltip.querySelector('.location').textContent = `${airport.city}, ${airport.country}`;
                tooltip.style.display = 'block';
            } else {
                tooltip.style.display = 'none';
            }
        }

        // Track mouse for tooltip
        document.addEventListener('mousemove', (e) => {
            const tooltip = document.getElementById('airport-tooltip');
            if (tooltip.style.display !== 'none') {
                tooltip.style.left = e.clientX + 15 + 'px';
                tooltip.style.top = e.clientY + 15 + 'px';
            }
        });

        // Clear buttons
        document.getElementById('clear-departure').addEventListener('click', () => {
            departureAirport = null;
            document.getElementById('departure-display').textContent = 'Select departure';
            resetFlight();
            updateFlightUI();
            updateVisibleAirports();
            updateFlightPath();
        });

        document.getElementById('clear-arrival').addEventListener('click', () => {
            arrivalAirport = null;
            document.getElementById('arrival-display').textContent = 'Select arrival';
            resetFlight();
            updateFlightUI();
            updateVisibleAirports();
            updateFlightPath();
        });

        function updateFlightUI() {
            const startBtn = document.getElementById('start-flight');
            startBtn.disabled = !(departureAirport && arrivalAirport);
        }

        // ============ FLIGHT PATH ============
        // ============ FLIGHT PATH ============
        function updateFlightPath() {
            if (departureAirport && arrivalAirport) {
                globe.arcsData([{
                    startLat: departureAirport.lat,
                    startLng: departureAirport.lon,
                    endLat: arrivalAirport.lat,
                    endLng: arrivalAirport.lon
                }]);

                // Calculate distance
                const dist = haversineDistance(
                    departureAirport.lat, departureAirport.lon,
                    arrivalAirport.lat, arrivalAirport.lon
                );
                document.getElementById('distance-value').textContent = `${Math.round(dist)} km`;

                // Calculate and display flight duration
                const durationMs = calculateFlightDuration(dist);
                const durationStr = formatDuration(durationMs);

                // Add estimated time display if it doesn't exist
                let timeDisplay = document.getElementById('estimated-time');
                if (!timeDisplay) {
                    const infoPanel = document.getElementById('flight-info').querySelector('.flight-stats') || document.getElementById('flight-info');
                    timeDisplay = document.createElement('div');
                    timeDisplay.id = 'estimated-time';
                    timeDisplay.innerHTML = `Est. Time: <span id="time-value" style="color: #60a5fa">${durationStr}</span>`;
                    infoPanel.appendChild(timeDisplay);
                } else {
                    document.getElementById('time-value').textContent = durationStr;
                }

                // Store duration for flight
                window.currentFlightDuration = durationMs;

            } else {
                globe.arcsData([]);
            }
        }

        function calculateFlightDuration(distanceKm) {
            // Average cruising speed of ~850 km/h
            const speedKmH = 850;
            // Add 30 mins for taxi/takeoff/landing overhead
            const overheadHours = 0.5;

            const hours = (distanceKm / speedKmH) + overheadHours;
            return hours * 60 * 60 * 1000; // Return milliseconds
        }

        function formatDuration(ms) {
            const totalMinutes = Math.floor(ms / (1000 * 60));
            const hours = Math.floor(totalMinutes / 60);
            const minutes = totalMinutes % 60;
            return `${hours}h ${minutes}m`;
        }

        function haversineDistance(lat1, lon1, lat2, lon2) {
            const R = 6371; // Earth's radius in km
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        // ============ FLIGHT ANIMATION ============
        document.getElementById('start-flight').addEventListener('click', startFlight);
        document.getElementById('pause-flight').addEventListener('click', togglePause);
        document.getElementById('reset-flight').addEventListener('click', resetFlight);

        let flightStartTime = 0;
        let flightPauseTime = 0;
        let totalPausedTime = 0;
        let lastFrameTime = 0;

        function startFlight() {
            if (!departureAirport || !arrivalAirport) return;

            flightInProgress = true;
            flightPaused = false;
            flightProgress = 0;

            // Initialize time tracking
            flightStartTime = Date.now();
            totalPausedTime = 0;

            // If we don't have a calculated duration yet (e.g. reload), recalc it
            if (!window.currentFlightDuration) {
                const dist = haversineDistance(
                    departureAirport.lat, departureAirport.lon,
                    arrivalAirport.lat, arrivalAirport.lon
                );
                window.currentFlightDuration = calculateFlightDuration(dist);
            }

            airplane.visible = true;

            // Move center button to top-right during flight
            document.getElementById('center-btn')?.classList.add('in-flight');
            document.getElementById('flight-info').style.display = 'block';
            document.getElementById('start-flight').textContent = 'Flying...';
            document.getElementById('start-flight').disabled = true;
            document.getElementById('pause-flight').textContent = '⏸ Pause';

            // Start Pomodoro if enabled
            startPomodoro();

            // Show window view button
            showWindowViewButton();

            animateFlight();
        }

        function togglePause() {
            flightPaused = !flightPaused;
            document.getElementById('pause-flight').textContent = flightPaused ? '▶ Resume' : '⏸ Pause';

            if (flightPaused) {
                // Determine when pause started
                flightPauseTime = Date.now();
            } else {
                // Resume: Add the duration of the pause to totalPausedTime
                // effectively "shifting" the start time forward
                const pausedDuration = Date.now() - flightPauseTime;
                totalPausedTime += pausedDuration;

                if (flightInProgress) {
                    animateFlight();
                }
            }
        }

        function resetFlight() {
            flightInProgress = false;
            flightPaused = false;
            flightProgress = 0;

            if (airplane) airplane.visible = false;
            if (animationId) cancelAnimationFrame(animationId);

            // Move center button back to bottom-left
            document.getElementById('center-btn')?.classList.remove('in-flight');

            // Clear the flight arc
            globe.arcsData([]);

            // Stop Pomodoro timer
            stopPomodoro();

            // Reset layovers
            layoverAirports = [];
            pendingLayover = false;
            document.getElementById('layover-container')?.classList.remove('active');

            document.getElementById('flight-info').style.display = 'none';
            document.getElementById('start-flight').textContent = 'Start Flight';
            document.getElementById('start-flight').disabled = !(departureAirport && arrivalAirport);
            document.getElementById('progress-fill').style.width = '0%';
            document.getElementById('progress-value').textContent = '0%';

            // Hide window view button
            hideWindowViewButton();

            // Clear any estimated time remaining text if we want, or keep it
        }

        // ============ TURBULENCE SYSTEM ============
        let turbulenceActive = false;
        let lastTurbulenceCheck = 0;
        const turbulenceCheckInterval = 10000; // Check every 10 seconds
        const turbulenceChance = 0.15; // 15% chance per check

        function startTurbulence() {
            if (turbulenceActive) return;
            turbulenceActive = true;

            const globeContainer = document.getElementById('globe-container');
            const warning = document.getElementById('turbulence-warning');

            globeContainer.classList.add('turbulence');
            warning.classList.add('active');

            // Random duration between 3-8 seconds
            const duration = 3000 + Math.random() * 5000;

            setTimeout(() => {
                stopTurbulence();
            }, duration);
        }

        function stopTurbulence() {
            turbulenceActive = false;
            document.getElementById('globe-container').classList.remove('turbulence');
            document.getElementById('turbulence-warning').classList.remove('active');
        }

        function checkTurbulence(progress) {
            // Only during cruise phase (15% to 85% of flight)
            if (progress < 0.15 || progress > 0.85) return;
            if (flightPaused || turbulenceActive) return;

            const now = Date.now();
            if (now - lastTurbulenceCheck < turbulenceCheckInterval) return;
            lastTurbulenceCheck = now;

            // Random chance of turbulence
            if (Math.random() < turbulenceChance) {
                startTurbulence();
            }
        }

        // ============ LAYOVER SYSTEM ============
        // Update the layover UI display
        function updateLayoverUI() {
            const container = document.getElementById('layover-container');
            const list = document.getElementById('layover-list');
            const addBtn = document.getElementById('add-layover-btn');

            if (!arrivalAirport) {
                container.classList.remove('active');
                return;
            }

            // Build the route list
            let html = '';
            let legNum = 1;

            // Departure → First destination
            html += `<div class="layover-item">
                <span><span class="leg-number">Leg ${legNum}</span>
                <span class="airport-code">${departureAirport.iata}</span>
                <span class="airport-name">→ ${layoverAirports.length > 0 ? layoverAirports[0].iata : arrivalAirport.iata}</span></span>
                ${layoverAirports.length > 0 ? `<button class="remove-btn" onclick="removeLayover(0)">✕</button>` : ''}
            </div>`;
            legNum++;

            // Layover legs
            for (let i = 0; i < layoverAirports.length; i++) {
                const from = layoverAirports[i];
                const to = i < layoverAirports.length - 1 ? layoverAirports[i + 1] : arrivalAirport;
                html += `<div class="layover-item">
                    <span><span class="leg-number">Leg ${legNum}</span>
                    <span class="airport-code">${from.iata}</span>
                    <span class="airport-name">→ ${to.iata}</span></span>
                    <button class="remove-btn" onclick="removeLayover(${i})">✕</button>
                </div>`;
                legNum++;
            }

            list.innerHTML = html;

            // Show/hide add button
            if (layoverAirports.length < MAX_LAYOVERS) {
                addBtn.classList.add('active');
            } else {
                addBtn.classList.remove('active');
            }

            container.classList.add('active');
        }

        // Add a layover stop
        function addLayover(airport) {
            if (layoverAirports.length >= MAX_LAYOVERS) return;
            layoverAirports.push(airport);
            pendingLayover = false;
            updateLayoverUI();
            updateLayoverFlightPath();
        }

        // Remove a layover stop
        function removeLayover(index) {
            layoverAirports.splice(index, 1);
            updateLayoverUI();
            updateLayoverFlightPath();
        }

        // Update flight path to show multi-leg route
        function updateLayoverFlightPath() {
            if (!departureAirport || !arrivalAirport) return;

            const arcs = [];
            let prev = departureAirport;

            // Add arcs for each leg
            for (const layover of layoverAirports) {
                arcs.push({
                    startLat: prev.lat,
                    startLng: prev.lon,
                    endLat: layover.lat,
                    endLng: layover.lon
                });
                prev = layover;
            }

            // Final leg to destination
            arcs.push({
                startLat: prev.lat,
                startLng: prev.lon,
                endLat: arrivalAirport.lat,
                endLng: arrivalAirport.lon
            });

            globe.arcsData(arcs);
        }

        // Add Layover button click
        document.getElementById('add-layover-btn')?.addEventListener('click', () => {
            pendingLayover = true;
            // The next airport click will add a layover instead of changing destination
        });

        // ============ POMODORO SYSTEM ============
        let pomodoroEnabled = false;
        let pomodoroState = 'work'; // 'work' or 'break'
        let pomodoroTimeLeft = 25 * 60; // seconds
        let pomodoroInterval = null;
        let pomodoroWorkCount = 1;
        const WORK_DURATION = 25 * 60; // 25 minutes
        const BREAK_DURATION = 5 * 60; // 5 minutes

        // Toggle Pomodoro mode
        document.getElementById('pomodoro-toggle')?.addEventListener('click', () => {
            pomodoroEnabled = !pomodoroEnabled;
            document.getElementById('pomodoro-toggle').classList.toggle('active', pomodoroEnabled);
        });

        function startPomodoro() {
            if (!pomodoroEnabled) return;

            pomodoroState = 'work';
            pomodoroTimeLeft = WORK_DURATION;
            pomodoroWorkCount = 1;
            updatePomodoroDisplay();
            document.getElementById('pomodoro-display').classList.add('active');

            // Start timer interval
            pomodoroInterval = setInterval(updatePomodoroTimer, 1000);
        }

        function stopPomodoro() {
            if (pomodoroInterval) {
                clearInterval(pomodoroInterval);
                pomodoroInterval = null;
            }
            document.getElementById('pomodoro-display').classList.remove('active');
        }

        function updatePomodoroTimer() {
            if (!flightInProgress || flightPaused) return;

            pomodoroTimeLeft--;

            if (pomodoroTimeLeft <= 0) {
                // Switch states
                if (pomodoroState === 'work') {
                    pomodoroState = 'break';
                    pomodoroTimeLeft = BREAK_DURATION;
                } else {
                    pomodoroState = 'work';
                    pomodoroTimeLeft = WORK_DURATION;
                    pomodoroWorkCount++;
                }
            }

            updatePomodoroDisplay();
        }

        function updatePomodoroDisplay() {
            const stateEl = document.getElementById('pomodoro-state');
            const timerEl = document.getElementById('pomodoro-timer');
            const progressEl = document.getElementById('pomodoro-progress-fill');

            // Format time as MM:SS
            const mins = Math.floor(pomodoroTimeLeft / 60);
            const secs = pomodoroTimeLeft % 60;
            timerEl.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;

            // Update state display
            if (pomodoroState === 'work') {
                stateEl.textContent = `🍅 WORK #${pomodoroWorkCount}`;
                stateEl.className = 'pomodoro-state work';
                progressEl.classList.remove('break');
                const progress = (pomodoroTimeLeft / WORK_DURATION) * 100;
                progressEl.style.width = `${progress}%`;
            } else {
                stateEl.textContent = `☕ BREAK`;
                stateEl.className = 'pomodoro-state break';
                progressEl.classList.add('break');
                const progress = (pomodoroTimeLeft / BREAK_DURATION) * 100;
                progressEl.style.width = `${progress}%`;
            }
        }

        function animateFlight() {
            if (!flightInProgress || flightPaused) return;

            // Calculate progress based on real time
            const now = Date.now();
            const elapsedTime = now - flightStartTime - totalPausedTime;

            // Log for debugging (optional) or update UI less frequently
            // console.log(`Elapsed: ${elapsedTime}ms / Duration: ${window.currentFlightDuration}ms`);

            if (window.currentFlightDuration > 0) {
                flightProgress = elapsedTime / window.currentFlightDuration;
            } else {
                flightProgress = 0;
            }

            if (flightProgress >= 1) {
                flightProgress = 1;
                flightInProgress = false;
                document.getElementById('start-flight').textContent = 'Flight Complete!';
                // Hide plane at destination
                if (airplane) airplane.visible = false;
                // Stop any active turbulence
                stopTurbulence();
                // Show full trail on completion
                updateFlightTrail(1);
                // Move center button back to bottom-left
                document.getElementById('center-btn')?.classList.remove('in-flight');
            }

            // Check for random turbulence during cruise
            checkTurbulence(flightProgress);

            updatePlanePosition(flightProgress);
            updateFlightInfo(flightProgress);
            updateFlightTrail(flightProgress); // Update trail behind plane

            if (flightInProgress) {
                animationId = requestAnimationFrame(animateFlight);
            }
        }

        // Update flight trail to show only traveled path (up to current progress)
        function updateFlightTrail(progress) {
            if (!departureAirport || !arrivalAirport || progress <= 0) {
                globe.arcsData([]);
                return;
            }

            // Calculate intermediate point at current progress
            const lat1 = departureAirport.lat * Math.PI / 180;
            const lon1 = departureAirport.lon * Math.PI / 180;
            const lat2 = arrivalAirport.lat * Math.PI / 180;
            const lon2 = arrivalAirport.lon * Math.PI / 180;

            const d = 2 * Math.asin(Math.sqrt(
                Math.pow(Math.sin((lat2 - lat1) / 2), 2) +
                Math.cos(lat1) * Math.cos(lat2) * Math.pow(Math.sin((lon2 - lon1) / 2), 2)
            ));

            if (d === 0) return;

            const A = Math.sin((1 - progress) * d) / Math.sin(d);
            const B = Math.sin(progress * d) / Math.sin(d);

            const x = A * Math.cos(lat1) * Math.cos(lon1) + B * Math.cos(lat2) * Math.cos(lon2);
            const y = A * Math.cos(lat1) * Math.sin(lon1) + B * Math.cos(lat2) * Math.sin(lon2);
            const z = A * Math.sin(lat1) + B * Math.sin(lat2);

            const currentLat = Math.atan2(z, Math.sqrt(x * x + y * y)) * 180 / Math.PI;
            const currentLng = Math.atan2(y, x) * 180 / Math.PI;

            // Update arc from departure to current position
            globe.arcsData([{
                startLat: departureAirport.lat,
                startLng: departureAirport.lon,
                endLat: currentLat,
                endLng: currentLng
            }]);
        }

        function updatePlanePosition(progress) {
            if (!airplane || !departureAirport || !arrivalAirport) return;

            // Interpolate position along great circle
            const lat1 = departureAirport.lat * Math.PI / 180;
            const lon1 = departureAirport.lon * Math.PI / 180;
            const lat2 = arrivalAirport.lat * Math.PI / 180;
            const lon2 = arrivalAirport.lon * Math.PI / 180;

            const d = 2 * Math.asin(Math.sqrt(
                Math.pow(Math.sin((lat2 - lat1) / 2), 2) +
                Math.cos(lat1) * Math.cos(lat2) * Math.pow(Math.sin((lon2 - lon1) / 2), 2)
            ));

            if (d === 0) return;

            const A = Math.sin((1 - progress) * d) / Math.sin(d);
            const B = Math.sin(progress * d) / Math.sin(d);

            const x = A * Math.cos(lat1) * Math.cos(lon1) + B * Math.cos(lat2) * Math.cos(lon2);
            const y = A * Math.cos(lat1) * Math.sin(lon1) + B * Math.cos(lat2) * Math.sin(lon2);
            const z = A * Math.sin(lat1) + B * Math.sin(lat2);

            const lat = Math.atan2(z, Math.sqrt(x * x + y * y));
            const lon = Math.atan2(y, x);

            // Calculate altitude with proper takeoff/landing curve
            // Altitude above globe surface in globe units (globe radius = 100)
            // Ground level = 0.5 (accounts for plane model height)
            // Cruise altitude = 3
            // Ground level needs to be above polygon altitude (0.006 * 100 = 0.6 units)
            const groundAlt = 1.0;
            const cruiseAlt = 3;

            let altitude;
            if (progress < 0.05) {
                // On ground - taxiing before takeoff
                altitude = groundAlt;
            } else if (progress < 0.15) {
                // Takeoff climb (5% to 15%) - smooth easing
                const t = (progress - 0.05) / 0.10; // 0 to 1
                const eased = t * t * (3 - 2 * t); // smoothstep
                altitude = groundAlt + (cruiseAlt - groundAlt) * eased;
            } else if (progress < 0.85) {
                // Cruise altitude
                altitude = cruiseAlt;
            } else if (progress < 0.95) {
                // Descent (85% to 95%) - smooth easing
                const t = (progress - 0.85) / 0.10; // 0 to 1
                const eased = t * t * (3 - 2 * t); // smoothstep
                altitude = cruiseAlt - (cruiseAlt - groundAlt) * eased;
            } else {
                // On ground - taxiing after landing
                altitude = groundAlt;
            }

            // Set global altitude for UI display
            currentAltitude = altitude;

            // Globe radius is ~100 units in globe.gl
            const globeRadius = 100;
            const radius = globeRadius + altitude;

            airplane.position.set(
                radius * Math.cos(lat) * Math.sin(lon),
                radius * Math.sin(lat),
                radius * Math.cos(lat) * Math.cos(lon)
            );

            // Orient plane to follow the flight path
            // Calculate next position for direction
            const nextProgress = Math.min(progress + 0.02, 1);
            const A2 = Math.sin((1 - nextProgress) * d) / Math.sin(d);
            const B2 = Math.sin(nextProgress * d) / Math.sin(d);
            const x2 = A2 * Math.cos(lat1) * Math.cos(lon1) + B2 * Math.cos(lat2) * Math.cos(lon2);
            const y2 = A2 * Math.cos(lat1) * Math.sin(lon1) + B2 * Math.cos(lat2) * Math.sin(lon2);
            const z2 = A2 * Math.sin(lat1) + B2 * Math.sin(lat2);
            const lat3 = Math.atan2(z2, Math.sqrt(x2 * x2 + y2 * y2));
            const lon3 = Math.atan2(y2, x2);

            const nextPos = new THREE.Vector3(
                radius * Math.cos(lat3) * Math.sin(lon3),
                radius * Math.sin(lat3),
                radius * Math.cos(lat3) * Math.cos(lon3)
            );

            // Use lookAt with the up vector pointing away from globe center
            const up = airplane.position.clone().normalize();

            // Create a temporary object to calculate the correct orientation
            const tempMatrix = new THREE.Matrix4();
            tempMatrix.lookAt(airplane.position, nextPos, up);
            airplane.quaternion.setFromRotationMatrix(tempMatrix);

            // FBX models typically have Y-up and Z-forward, adjust as needed
            // Rotate 180 degrees around Y to face forward direction correctly
            airplane.rotateY(Math.PI);

            // Tilt plane for takeoff/landing
            if (progress < 0.1) {
                airplane.rotateX(-0.2); // Nose up for takeoff
            } else if (progress > 0.9) {
                airplane.rotateX(0.2); // Nose down for landing
            }
        }

        function updateFlightInfo(progress) {
            const percent = Math.round(progress * 100);
            document.getElementById('progress-value').textContent = `${percent}%`;
            document.getElementById('progress-fill').style.width = `${percent}%`;

            // Update remaining time if available
            if (window.currentFlightDuration) {
                const remainingMs = Math.max(0, window.currentFlightDuration * (1 - progress));
                const remainingStr = formatDuration(remainingMs);

                // Update time display
                const timeValue = document.getElementById('time-value');
                if (timeValue) {
                    timeValue.textContent = remainingStr;
                }
            }

            // Altitude display
            let altitudeKm;
            if (progress < 0.1) {
                altitudeKm = progress * 10 * 11; // 0-11km during takeoff
            } else if (progress > 0.9) {
                altitudeKm = (1 - progress) * 10 * 11;
            } else {
                altitudeKm = 11; // Cruise at 11km
            }
            document.getElementById('altitude-value').textContent = `${altitudeKm.toFixed(1)} km`;
        }

        // ============ COUNTRIES ============
        async function loadCountries() {
            try {
                const response = await fetch('https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson');
                const countries = await response.json();

                globe
                    .polygonsData(countries.features)
                    .polygonCapColor(() => '#6b7280')
                    .polygonSideColor(() => '#4a5568')
                    .polygonStrokeColor(() => '#000000')
                    .polygonAltitude(0.006);
            } catch (err) {
                console.error('Failed to load countries:', err);
            }
        }

        // ============ UPDATE ON ZOOM ============
        // Removed zoom-based updates - now only showing 200 airports for performance

        // ============ TICKET PANEL LOGIC ============
        const ticketPanel = document.getElementById('ticket-panel');
        const ticketHandle = document.getElementById('ticket-handle');
        const ticketSearch = document.getElementById('ticket-search');
        const ticketResults = document.getElementById('ticket-results');
        const bookFlightBtn = document.getElementById('book-flight');
        const flightOverlay = document.getElementById('flight-overlay');
        const flightControlsOverlay = document.getElementById('flight-controls-overlay');

        // Toggle panel open/close
        ticketHandle.addEventListener('click', () => {
            ticketPanel.classList.toggle('collapsed');
        });

        // Ticket search functionality
        ticketSearch.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();

            if (query.length < 2) {
                ticketResults.innerHTML = '';
                return;
            }

            const matches = allAirports.filter(a =>
                a.name.toLowerCase().includes(query) ||
                a.city.toLowerCase().includes(query) ||
                (a.iata && a.iata.toLowerCase().includes(query))
            ).slice(0, 8);

            ticketResults.innerHTML = matches.map(a => `
                <div class="result-item" data-iata="${a.iata || ''}" data-name="${a.name}" data-city="${a.city}" data-lat="${a.lat}" data-lon="${a.lon}">
                    <span>
                        <span class="code">${a.iata || '---'}</span>
                        <span class="name">${a.city}</span>
                    </span>
                    <span style="color: #666; font-size: 11px;">${a.country}</span>
                </div>
            `).join('');

            // Add click handlers
            ticketResults.querySelectorAll('.result-item').forEach(item => {
                item.addEventListener('click', () => {
                    selectTicketAirport(item.dataset);
                    ticketSearch.value = '';
                    ticketResults.innerHTML = '';
                });
            });
        });

        // Select airport for ticket
        function selectTicketAirport(data) {
            const airport = {
                iata: data.iata,
                name: data.name,
                city: data.city,
                lat: parseFloat(data.lat),
                lon: parseFloat(data.lon)
            };

            // If no departure, set departure. Otherwise set arrival.
            if (!departureAirport) {
                departureAirport = airport;
                document.getElementById('ticket-from-code').textContent = airport.iata || '---';
                document.getElementById('ticket-from-city').textContent = airport.city;

                // Show plane at departure airport (on ground)
                if (airplane) {
                    showPlaneAtAirport(airport);
                }
            } else if (!arrivalAirport) {
                arrivalAirport = airport;
                document.getElementById('ticket-to-code').textContent = airport.iata || '---';
                document.getElementById('ticket-to-city').textContent = airport.city;
            } else {
                // Both selected, replace departure
                departureAirport = airport;
                document.getElementById('ticket-from-code').textContent = airport.iata || '---';
                document.getElementById('ticket-from-city').textContent = airport.city;
                // Clear arrival
                arrivalAirport = null;
                document.getElementById('ticket-to-code').textContent = '---';
                document.getElementById('ticket-to-city').textContent = 'Select arrival';

                // Show plane at new departure
                if (airplane) {
                    showPlaneAtAirport(airport);
                }
            }

            updateTicketDetails();
            updateFlightPath();
        }

        // Show plane parked at an airport (on ground)
        function showPlaneAtAirport(airport) {
            if (!airplane) return;

            const lat = airport.lat * Math.PI / 180;
            const lon = airport.lon * Math.PI / 180;

            // Position on ground (globe radius = 100, small offset for model)
            // Ground level above polygon altitude (0.006 * 100 = 0.6 units)
            const groundAlt = 1.0;
            const radius = 100 + groundAlt;

            airplane.position.set(
                radius * Math.cos(lat) * Math.sin(lon),
                radius * Math.sin(lat),
                radius * Math.cos(lat) * Math.cos(lon)
            );

            // Orient plane to face "forward" (roughly east)
            const up = airplane.position.clone().normalize();
            const forward = new THREE.Vector3(0, 1, 0).cross(up).normalize();
            const tempMatrix = new THREE.Matrix4();
            tempMatrix.lookAt(airplane.position, airplane.position.clone().add(forward), up);
            airplane.quaternion.setFromRotationMatrix(tempMatrix);
            airplane.rotateY(Math.PI);

            airplane.visible = true;
        }

        // Update ticket details (distance, time)
        function updateTicketDetails() {
            if (departureAirport && arrivalAirport) {
                const dist = haversineDistance(
                    departureAirport.lat, departureAirport.lon,
                    arrivalAirport.lat, arrivalAirport.lon
                );
                const durationMs = calculateFlightDuration(dist);
                window.currentFlightDuration = durationMs;

                document.getElementById('ticket-distance').textContent = `${Math.round(dist)} km`;
                document.getElementById('ticket-duration').textContent = formatDuration(durationMs);
                bookFlightBtn.disabled = false;
            } else {
                document.getElementById('ticket-distance').textContent = '---';
                document.getElementById('ticket-duration').textContent = '---';
                bookFlightBtn.disabled = true;
            }
        }

        // Book flight button
        bookFlightBtn.addEventListener('click', () => {
            if (!departureAirport || !arrivalAirport) return;

            // Hide ticket panel completely during flight
            ticketPanel.style.display = 'none';

            // Show flight overlay and controls
            flightOverlay.classList.add('active');
            flightControlsOverlay.classList.add('active');

            // Update overlay
            document.getElementById('overlay-from').textContent = departureAirport.iata || departureAirport.city;
            document.getElementById('overlay-to').textContent = arrivalAirport.iata || arrivalAirport.city;

            // Start the flight
            startFlight();
        });

        // New flight controls
        document.getElementById('pause-flight-new').addEventListener('click', () => {
            togglePause();
            document.getElementById('pause-flight-new').textContent = flightPaused ? '▶ Resume' : '⏸ Pause';
        });

        document.getElementById('reset-flight-new').addEventListener('click', () => {
            resetFlight();
            // Hide overlays
            flightOverlay.classList.remove('active');
            flightControlsOverlay.classList.remove('active');
            // Show ticket panel again
            ticketPanel.style.display = 'flex';
            ticketPanel.classList.add('collapsed');
            // Reset ticket
            document.getElementById('ticket-from-code').textContent = '---';
            document.getElementById('ticket-from-city').textContent = 'Select departure';
            document.getElementById('ticket-to-code').textContent = '---';
            document.getElementById('ticket-to-city').textContent = 'Select arrival';
            document.getElementById('ticket-distance').textContent = '---';
            document.getElementById('ticket-duration').textContent = '---';
            departureAirport = null;
            arrivalAirport = null;
            bookFlightBtn.disabled = true;
        });

        // Update flight overlay during flight
        function updateFlightOverlay(progress) {
            const percent = Math.round(progress * 100);
            document.getElementById('overlay-progress').textContent = `${percent}%`;

            if (window.currentFlightDuration) {
                const remainingMs = Math.max(0, window.currentFlightDuration * (1 - progress));
                document.getElementById('overlay-time').textContent = formatDuration(remainingMs);
            }

            // Altitude
            let altitudeKm;
            if (progress < 0.05) {
                altitudeKm = 0;
            } else if (progress < 0.15) {
                const t = (progress - 0.05) / 0.10;
                altitudeKm = t * 11;
            } else if (progress < 0.85) {
                altitudeKm = 11;
            } else if (progress < 0.95) {
                const t = (progress - 0.85) / 0.10;
                altitudeKm = 11 - t * 11;
            } else {
                altitudeKm = 0;
            }
            document.getElementById('overlay-altitude').textContent = `${altitudeKm.toFixed(1)} km`;
        }

        // Modify animateFlight to update overlay
        const originalAnimateFlight = animateFlight;
        animateFlight = function () {
            originalAnimateFlight();
            if (flightProgress >= 0) {
                updateFlightOverlay(flightProgress);
            }
            // When flight completes, hide overlays after delay
            if (flightProgress >= 1) {
                setTimeout(() => {
                    flightOverlay.classList.remove('active');
                    flightControlsOverlay.classList.remove('active');
                }, 2000);
            }
        };

        // ============ NEW UI LOGIC ============
        const startJourneyBtn = document.getElementById('start-journey-btn');
        const menuBtn = document.getElementById('menu-btn');
        const menuPanel = document.getElementById('menu-panel');
        const menuOverlay = document.getElementById('menu-overlay');
        const menuClose = document.getElementById('menu-close');
        const flightHistoryList = document.getElementById('flight-history-list');
        const timeSelector = document.getElementById('time-selector');
        const airportCardsList = document.getElementById('airport-cards-list');
        const bookSingleBtn = document.getElementById('book-single-btn');
        const bookMultiBtn = document.getElementById('book-multi-btn');
        const multiFlightScreen = document.getElementById('multi-flight-screen');
        const boardingPass = document.getElementById('boarding-pass');
        const checkinBtn = document.getElementById('checkin-btn');
        const inflightBar = document.getElementById('inflight-bar');
        const inflightControlsEl = document.getElementById('inflight-controls');
        const pauseBtn = document.getElementById('pause-btn');
        const endFlightBtn = document.getElementById('end-flight-btn');

        let selectedTime = 60; // Default 1 hour
        let selectedDestination = null;
        let userLocation = null;
        let currentFlightData = null; // Store current flight for history
        let selectedFocusType = 'Deep Work'; // Default focus type
        let currentAltitude = 0; // Track altitude for display
        let useMetric = localStorage.getItem('useMetric') !== 'false'; // Default true (metric)
        let manualDeparture = null; // Manually selected departure airport
        let nearestAirport = null; // Auto-detected nearest airport
        let multiFlightRoute = []; // Array of stops for multi-flight
        let multiFlightLayovers = []; // Duration in minutes for each layover
        let addingMultiFlightStop = false; // Whether we're adding a stop in multi-flight screen

        // ============ FLIGHT HISTORY SYSTEM ============
        function getFlightHistory() {
            const stored = localStorage.getItem('flightHistory');
            return stored ? JSON.parse(stored) : [];
        }

        function saveFlightHistory(history) {
            localStorage.setItem('flightHistory', JSON.stringify(history));
        }

        function addFlightToHistory(flight) {
            const history = getFlightHistory();
            history.unshift(flight); // Add to beginning
            if (history.length > 50) history.pop(); // Keep max 50
            saveFlightHistory(history);
        }

        function renderFlightHistory() {
            const history = getFlightHistory();

            // Update stats
            updateMenuStats(history);

            if (history.length === 0) {
                flightHistoryList.innerHTML = '<div class="flight-history-empty">No flights yet. Start your first journey!</div>';
                return;
            }

            flightHistoryList.innerHTML = history.map((flight, index) => `
                <div class="history-item" data-index="${index}">
                    <div class="history-item-header">
                        <span class="history-route">${flight.fromCode} → ${flight.toCode}</span>
                        <span class="history-status ${flight.status}">${flight.status}</span>
                    </div>
                    <div class="history-details">
                        <span>${flight.distance} Km</span>
                        <span>${flight.duration}</span>
                        <span>${flight.date}</span>
                    </div>
                </div>
            `).join('');

            // Add click handlers to view flight details
            document.querySelectorAll('.history-item').forEach(item => {
                item.addEventListener('click', () => {
                    const index = parseInt(item.dataset.index);
                    viewFlightDetails(history[index]);
                });
            });
        }

        function updateMenuStats(history) {
            const completed = history.filter(f => f.status === 'completed');

            // Total distance
            const totalDistance = completed.reduce((sum, f) => sum + (f.distance || 0), 0);
            document.getElementById('stat-total-distance').textContent = totalDistance.toLocaleString();

            // Unique airports
            const airports = new Set();
            completed.forEach(f => {
                if (f.fromCode) airports.add(f.fromCode);
                if (f.toCode) airports.add(f.toCode);
            });
            document.getElementById('stat-airports-visited').textContent = airports.size;

            // Completed flights
            document.getElementById('stat-flights-completed').textContent = completed.length;
        }

        function viewFlightDetails(flight) {
            // Close menu
            closeMenu();

            // Show boarding pass with flight details
            boardingPass.classList.add('active');
            document.getElementById('pass-from-code').textContent = flight.fromCode;
            document.getElementById('pass-from-city').textContent = flight.fromCity;
            document.getElementById('pass-to-code').textContent = flight.toCode;
            document.getElementById('pass-to-city').textContent = flight.toCity;
            document.getElementById('pass-gate').textContent = flight.gate;
            document.getElementById('pass-seat').textContent = flight.seat;
            document.getElementById('pass-focus').textContent = flight.focus;
            document.getElementById('pass-distance').textContent = flight.distance + 'Km';
            document.getElementById('pass-date').textContent = flight.date;
            document.getElementById('pass-flight-number').textContent = flight.flightNumber;

            // Change button text based on status
            const statusBadge = boardingPass.querySelector('.now-badge');
            if (flight.status === 'completed') {
                statusBadge.textContent = 'Completed';
                statusBadge.style.background = '#22c55e';
                checkinBtn.textContent = 'Close';
            } else {
                statusBadge.textContent = 'Cancelled';
                statusBadge.style.background = '#ef4444';
                checkinBtn.textContent = 'Close';
            }

            // Make checkin button just close the pass when viewing history
            checkinBtn.onclick = () => {
                boardingPass.classList.remove('active');
                statusBadge.textContent = 'Now';
                statusBadge.style.background = '#22c55e';
                checkinBtn.textContent = 'Checking in';
                checkinBtn.onclick = null; // Reset to default behavior
            };
        }

        // Menu interactions
        function openMenu() {
            menuPanel.classList.add('active');
            menuOverlay.classList.add('active');
            renderFlightHistory();
        }

        function closeMenu() {
            menuPanel.classList.remove('active');
            menuOverlay.classList.remove('active');
        }

        menuBtn.addEventListener('click', openMenu);
        menuClose.addEventListener('click', closeMenu);
        menuOverlay.addEventListener('click', closeMenu);

        // Focus type selection
        document.querySelectorAll('.focus-type').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.focus-type').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                selectedFocusType = btn.dataset.type;
            });
        });

        // Boarding pass style selection
        let selectedPassStyle = localStorage.getItem('passStyle') || 'classic';

        function applyPassStyle(style) {
            const pass = document.getElementById('boarding-pass');
            // Remove all style classes
            pass.classList.remove('style-minimal', 'style-inverted');
            // Add selected style (classic has no class, it's the default)
            if (style !== 'classic') {
                pass.classList.add('style-' + style);
            }
        }

        function initPassStyleSelector() {
            // Set initial selection from localStorage
            document.querySelectorAll('.style-option').forEach(btn => {
                btn.classList.toggle('selected', btn.dataset.style === selectedPassStyle);
            });
            applyPassStyle(selectedPassStyle);
        }

        document.querySelectorAll('.style-option').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.style-option').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                selectedPassStyle = btn.dataset.style;
                localStorage.setItem('passStyle', selectedPassStyle);
                applyPassStyle(selectedPassStyle);
            });
        });

        // Initialize style selector after DOM is ready
        initPassStyleSelector();

        // Unit toggle (Metric/Imperial)
        document.querySelectorAll('#unit-toggle button').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('#unit-toggle button').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                useMetric = btn.dataset.unit === 'metric';
                localStorage.setItem('useMetric', useMetric);
            });
        });

        // Initialize unit toggle UI state
        function initUnitToggle() {
            const btns = document.querySelectorAll('#unit-toggle button');
            btns.forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(`#unit-toggle button[data-unit="${useMetric ? 'metric' : 'imperial'}"]`);
            if (activeBtn) activeBtn.classList.add('active');
        }
        initUnitToggle();

        // ============ DEPARTURE SELECTION ============
        const departureModal = document.getElementById('departure-modal');
        const departureModalClose = document.getElementById('departure-modal-close');
        const changeDepartureBtn = document.getElementById('change-departure-btn');
        const departureSearchInput = document.getElementById('departure-search-input');
        const departureResults = document.getElementById('departure-results');
        const departureDisplayEl = document.getElementById('departure-display');

        function openDepartureModal() {
            departureModal.classList.add('active');
            departureSearchInput.value = '';
            departureSearchInput.focus();
            renderDepartureResults(''); // Show nearby airports by default
        }

        function closeDepartureModal() {
            departureModal.classList.remove('active');
        }

        function renderDepartureResults(query) {
            let results = [];
            if (query.length < 2) {
                // Show nearby airports based on user location
                if (userLocation && allAirports.length > 0) {
                    results = allAirports
                        .map(a => ({
                            ...a,
                            distance: haversineDistance(userLocation.lat, userLocation.lon, a.lat, a.lon)
                        }))
                        .sort((a, b) => a.distance - b.distance)
                        .slice(0, 10);
                }
            } else {
                // Search airports
                results = allAirports
                    .filter(a =>
                        a.iata?.toLowerCase().includes(query.toLowerCase()) ||
                        a.name?.toLowerCase().includes(query.toLowerCase()) ||
                        a.city?.toLowerCase().includes(query.toLowerCase())
                    )
                    .slice(0, 15);
            }

            departureResults.innerHTML = results.map(airport => `
                <div class="departure-result-item" data-icao="${airport.icao}">
                    <div>
                        <span class="code">${airport.iata || airport.icao}</span>
                        <span class="name">${airport.name}</span>
                    </div>
                    <div class="city">${airport.city}, ${airport.country}</div>
                </div>
            `).join('');

            // Add click handlers
            departureResults.querySelectorAll('.departure-result-item').forEach(item => {
                item.addEventListener('click', () => {
                    const airport = allAirports.find(a => a.icao === item.dataset.icao);
                    if (airport) {
                        selectDeparture(airport);
                    }
                });
            });
        }

        function selectDeparture(airport) {
            manualDeparture = airport;
            updateDepartureDisplay();
            closeDepartureModal();
            updateAirportCards(); // Recalculate destinations from new departure
        }

        function updateDepartureDisplay() {
            const dep = manualDeparture || nearestAirport;
            if (dep) {
                departureDisplayEl.textContent = `${dep.iata || dep.icao} - ${dep.city || dep.name}`;
            } else {
                departureDisplayEl.textContent = 'Detecting location...';
            }
        }

        changeDepartureBtn?.addEventListener('click', openDepartureModal);
        departureModalClose?.addEventListener('click', closeDepartureModal);

        departureSearchInput?.addEventListener('input', () => {
            renderDepartureResults(departureSearchInput.value.trim());
        });


        // Get user's location for calculating nearby airports
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    userLocation = { lat: pos.coords.latitude, lon: pos.coords.longitude };
                    console.log('User location:', userLocation);

                    // Show user location marker on globe
                    globe.htmlElementsData([{ lat: userLocation.lat, lng: userLocation.lon }]);

                    // Zoom to user location with smooth animation
                    setTimeout(() => {
                        globe.pointOfView({
                            lat: userLocation.lat,
                            lng: userLocation.lon,
                            altitude: 0.6
                        }, 1500);
                    }, 500);

                    // Find nearest airport (if airports already loaded)
                    findAndSetNearestAirport();
                },
                () => {
                    // Default to Paris if geolocation fails
                    userLocation = { lat: 48.8566, lon: 2.3522 };
                    globe.htmlElementsData([{ lat: userLocation.lat, lng: userLocation.lon }]);
                    globe.pointOfView({ lat: userLocation.lat, lng: userLocation.lon, altitude: 0.6 }, 1500);
                }
            );
        } else {
            userLocation = { lat: 48.8566, lon: 2.3522 };
            globe.htmlElementsData([{ lat: userLocation.lat, lng: userLocation.lon }]);
            globe.pointOfView({ lat: userLocation.lat, lng: userLocation.lon, altitude: 0.6 }, 1500);
        }

        // Start Journey button
        startJourneyBtn.addEventListener('click', () => {
            startJourneyBtn.style.display = 'none';
            menuBtn.style.display = 'none';
            timeSelector.classList.add('active');

            // Hide globe during booking flow
            document.getElementById('globe-container').style.opacity = '0.1';

            // Hide destination pin during booking
            hideDestinationPin();

            // Hide center button during booking
            document.getElementById('center-btn').style.display = 'none';

            updateAirportCards();
        });

        // Time option selection
        document.querySelectorAll('.time-option').forEach(option => {
            option.addEventListener('click', () => {
                document.querySelectorAll('.time-option').forEach(o => o.classList.remove('selected'));
                option.classList.add('selected');
                selectedTime = parseInt(option.dataset.minutes);
                updateAirportCards();
            });
        });

        // Update airport cards based on selected time
        function updateAirportCards() {
            if (!userLocation || allAirports.length === 0) {
                setTimeout(updateAirportCards, 500);
                return;
            }

            // Get departure point (manual selection or nearest airport to user)
            const depAirport = manualDeparture || nearestAirport;
            const depLat = depAirport ? depAirport.lat : userLocation.lat;
            const depLon = depAirport ? depAirport.lon : userLocation.lon;

            // Calculate distance range for selected time (850 km/h average speed)
            // NOTE: calculateFlightDuration adds 30min overhead, so we need to subtract it
            const speedKmH = 850;
            const overheadMinutes = 30; // Must match calculateFlightDuration's overhead
            const effectiveFlightMinutes = Math.max(0, selectedTime - overheadMinutes);
            const targetDistKm = (effectiveFlightMinutes / 60) * speedKmH;
            const tolerance = Math.max(50, targetDistKm * 0.3); // 30% tolerance, minimum 50km

            // Find airports within the time range
            const matchingAirports = allAirports
                .map(airport => {
                    const dist = haversineDistance(depLat, depLon, airport.lat, airport.lon);
                    return { ...airport, distance: dist };
                })
                .filter(a => a.distance >= targetDistKm - tolerance && a.distance <= targetDistKm + tolerance && a.iata && a !== depAirport)
                .sort((a, b) => Math.abs(a.distance - targetDistKm) - Math.abs(b.distance - targetDistKm))
                .slice(0, 10);

            // Render cards
            airportCardsList.innerHTML = matchingAirports.map(a => {
                const flightTime = formatDuration(calculateFlightDuration(a.distance));
                return `
                    <div class="airport-card" data-iata="${a.iata}" data-lat="${a.lat}" data-lon="${a.lon}" data-city="${a.city}" data-name="${a.name}" data-distance="${a.distance}">
                        <div class="code-btn">
                            <span class="plane-icon">✈</span>
                            <span>${a.iata}</span>
                        </div>
                        <div class="city-name">${a.city || a.name}</div>
                        <div class="flight-time">${flightTime}</div>
                    </div>
                `;
            }).join('');

            // Add click handlers
            document.querySelectorAll('.airport-card').forEach(card => {
                card.addEventListener('click', () => {
                    const airport = {
                        iata: card.dataset.iata,
                        lat: parseFloat(card.dataset.lat),
                        lon: parseFloat(card.dataset.lon),
                        city: card.dataset.city,
                        name: card.dataset.name,
                        distance: parseFloat(card.dataset.distance)
                    };

                    // Check if we're adding a layover
                    if (pendingLayover && arrivalAirport && layoverAirports.length < MAX_LAYOVERS) {
                        // Add as layover stop
                        addLayover(airport);
                        return;
                    }

                    // Normal destination selection
                    document.querySelectorAll('.airport-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    selectedDestination = airport;
                    arrivalAirport = airport;

                    // Enable both book buttons
                    bookSingleBtn.disabled = false;
                    bookMultiBtn.disabled = false;

                    // Set departure as user location (find nearest airport)
                    setDepartureFromLocation();
                });
            });
        }

        // Find nearest airport to user as departure
        function setDepartureFromLocation() {
            if (!userLocation) return;

            const nearest = allAirports
                .filter(a => a.iata)
                .map(a => ({ ...a, distance: haversineDistance(userLocation.lat, userLocation.lon, a.lat, a.lon) }))
                .sort((a, b) => a.distance - b.distance)[0];

            if (nearest) {
                departureAirport = nearest;
            }
        }

        // Single Flight button - book directly
        bookSingleBtn.addEventListener('click', () => {
            if (!selectedDestination) return;

            // Use manual departure or nearest airport as departure
            departureAirport = manualDeparture || nearestAirport;

            if (!departureAirport) {
                console.error('No departure airport set');
                return;
            }

            // Set arrival airport
            arrivalAirport = {
                lat: selectedDestination.lat,
                lon: selectedDestination.lon,
                iata: selectedDestination.iata,
                city: selectedDestination.city,
                name: selectedDestination.name
            };

            // Update flight path
            updateFlightPath();

            // Show destination pin on arrival airport
            showDestinationPin(arrivalAirport);

            // Hide time selector, show boarding pass
            timeSelector.classList.remove('active');
            boardingPass.classList.add('active');

            // Update boarding pass details
            document.getElementById('pass-from-code').textContent = departureAirport.iata || '---';
            document.getElementById('pass-from-city').textContent = departureAirport.city || departureAirport.name || '';
            document.getElementById('pass-to-code').textContent = arrivalAirport.iata;
            document.getElementById('pass-to-city').textContent = arrivalAirport.city || arrivalAirport.name || '';

            // Random gate and seat
            const gates = ['A', 'B', 'C', 'D', 'E', 'F'];
            const gate = gates[Math.floor(Math.random() * gates.length)] + Math.floor(Math.random() * 20 + 1);
            const seat = String.fromCharCode(65 + Math.floor(Math.random() * 6)) + Math.floor(Math.random() * 30 + 1);
            const focus = selectedFocusType; // Use selected focus type
            const flightNumber = 'Flight FF-' + Math.floor(Math.random() * 9000 + 1000);
            const dateStr = new Date().toISOString().split('T')[0].replace(/-/g, '/');

            document.getElementById('pass-gate').textContent = gate;
            document.getElementById('pass-seat').textContent = seat;
            document.getElementById('pass-focus').textContent = focus;
            document.getElementById('pass-distance').textContent = Math.round(selectedDestination.distance) + 'Km';
            document.getElementById('pass-date').textContent = dateStr;
            document.getElementById('pass-flight-number').textContent = flightNumber;

            // Store flight data for history
            currentFlightData = {
                fromCode: departureAirport.iata || '---',
                fromCity: departureAirport.city || departureAirport.name || '',
                toCode: arrivalAirport.iata,
                toCity: arrivalAirport.city || arrivalAirport.name || '',
                gate: gate,
                seat: seat,
                focus: focus,
                distance: Math.round(selectedDestination.distance),
                duration: formatDuration(calculateFlightDuration(selectedDestination.distance)),
                date: dateStr,
                flightNumber: flightNumber,
                status: 'cancelled' // Default to cancelled, change to completed when done
            };

            // Show plane at departure
            if (airplane) {
                showPlaneAtAirport(departureAirport);
            }
        });

        // Check in button (starts flight)
        checkinBtn.addEventListener('click', () => {
            boardingPass.classList.remove('active');
            inflightBar.classList.add('active');
            inflightControlsEl.classList.add('active');

            // Show globe again for flight
            document.getElementById('globe-container').style.opacity = '1';
            timeSelector.classList.remove('active');

            startFlight();
        });

        // Pause button
        pauseBtn.addEventListener('click', () => {
            togglePause();
            pauseBtn.textContent = flightPaused ? '▶ Resume' : '⏸ Pause';
        });

        // ============ MULTI FLIGHT SCREEN ============
        // Multi Flight button - open route builder
        bookMultiBtn.addEventListener('click', () => {
            if (!selectedDestination) return;

            // Initialize multi-flight route with departure and selected destination
            departureAirport = manualDeparture || nearestAirport;
            if (!departureAirport) return;

            multiFlightRoute = [departureAirport, selectedDestination];
            multiFlightLayovers = [30]; // Default 30min layover between

            // Hide time selector, show multi-flight screen
            timeSelector.classList.remove('active');
            multiFlightScreen.classList.add('active');

            // Populate multi-flight airports and render route
            populateMultiFlightAirports();
            renderMultiFlightRoute();
        });

        // Close multi-flight screen
        document.getElementById('multi-flight-close').addEventListener('click', () => {
            multiFlightScreen.classList.remove('active');
            timeSelector.classList.add('active');
        });

        // Populate airport cards in multi-flight screen
        let multiFlightSelectedTime = 30; // Default 30min for leg

        function populateMultiFlightAirports() {
            const container = document.getElementById('multi-flight-airports');
            if (!allAirports || allAirports.length === 0) return;

            // Get all airports with distance from current last stop
            const lastStop = multiFlightRoute[multiFlightRoute.length - 1];

            // Calculate distance range for selected time (same logic as main screen)
            const speedKmH = 850;
            const overheadMinutes = 30;
            const effectiveFlightMinutes = Math.max(0, multiFlightSelectedTime - overheadMinutes);
            const targetDistKm = (effectiveFlightMinutes / 60) * speedKmH;
            const tolerance = Math.max(50, targetDistKm * 0.3);

            const airports = allAirports
                .filter(a => a.iata && !multiFlightRoute.find(s => s.iata === a.iata))
                .map(a => ({ ...a, distance: haversineDistance(lastStop.lat, lastStop.lon, a.lat, a.lon) }))
                .filter(a => a.distance >= targetDistKm - tolerance && a.distance <= targetDistKm + tolerance)
                .sort((a, b) => Math.abs(a.distance - targetDistKm) - Math.abs(b.distance - targetDistKm))
                .slice(0, 15);

            container.innerHTML = airports.map(a => {
                const flightTime = formatDuration(calculateFlightDuration(a.distance));
                return `
                    <div class="airport-card" data-iata="${a.iata}" data-lat="${a.lat}" data-lon="${a.lon}" data-city="${a.city || ''}" data-name="${a.name}">
                        <div class="code-btn">
                            <span class="plane-icon">✈</span>
                            <span>${a.iata}</span>
                        </div>
                        <div class="city-name">${a.city || a.name}</div>
                        <div class="flight-time">${flightTime}</div>
                    </div>
                `;
            }).join('');

            // Add click handlers
            container.querySelectorAll('.airport-card').forEach(card => {
                card.addEventListener('click', () => {
                    const airport = {
                        iata: card.dataset.iata,
                        lat: parseFloat(card.dataset.lat),
                        lon: parseFloat(card.dataset.lon),
                        city: card.dataset.city,
                        name: card.dataset.name
                    };
                    addMultiFlightStop(airport);
                });
            });
        }

        // Multi-flight time selector click handlers
        document.querySelectorAll('#multi-flight-time-options .time-option').forEach(option => {
            option.addEventListener('click', () => {
                document.querySelectorAll('#multi-flight-time-options .time-option').forEach(o => o.classList.remove('selected'));
                option.classList.add('selected');
                multiFlightSelectedTime = parseInt(option.dataset.minutes);
                populateMultiFlightAirports();
            });
        });

        // Add a stop to multi-flight route
        function addMultiFlightStop(airport) {
            if (multiFlightRoute.length >= 5) return; // Max 5 stops
            multiFlightRoute.push(airport);
            multiFlightLayovers.push(30); // Default 30min
            renderMultiFlightRoute();
            populateMultiFlightAirports();
        }

        // Remove a stop from multi-flight route
        function removeMultiFlightStop(index) {
            if (index <= 0 || index >= multiFlightRoute.length - 1) return; // Can't remove first or last
            multiFlightRoute.splice(index, 1);
            multiFlightLayovers.splice(index - 1, 1);
            renderMultiFlightRoute();
            populateMultiFlightAirports();
        }

        // Render the route stops
        function renderMultiFlightRoute() {
            const container = document.getElementById('route-stops');
            let html = '';

            for (let i = 0; i < multiFlightRoute.length; i++) {
                const stop = multiFlightRoute[i];
                const isFirst = i === 0;
                const isLast = i === multiFlightRoute.length - 1;

                html += `
                    <div class="route-stop">
                        <div class="stop-number">${i + 1}</div>
                        <div class="stop-info">
                            <div class="stop-code">${stop.iata}</div>
                            <div class="stop-name">${stop.city || stop.name || ''}</div>
                        </div>
                        ${!isFirst && !isLast ? `<button class="remove-stop" onclick="removeMultiFlightStop(${i})">✕</button>` : ''}
                    </div>
                `;

                // Add layover duration selector between stops
                if (!isLast) {
                    html += `
                        <div class="layover-duration">
                            <span>⏱ Layover:</span>
                            <select onchange="updateLayoverDuration(${i}, this.value)">
                                <option value="15" ${multiFlightLayovers[i] === 15 ? 'selected' : ''}>15 min</option>
                                <option value="30" ${multiFlightLayovers[i] === 30 ? 'selected' : ''}>30 min</option>
                                <option value="45" ${multiFlightLayovers[i] === 45 ? 'selected' : ''}>45 min</option>
                                <option value="60" ${multiFlightLayovers[i] === 60 ? 'selected' : ''}>1 hour</option>
                                <option value="120" ${multiFlightLayovers[i] === 120 ? 'selected' : ''}>2 hours</option>
                            </select>
                        </div>
                    `;
                }
            }

            container.innerHTML = html;

            // Enable confirm button if we have at least 2 stops
            document.getElementById('confirm-route-btn').disabled = multiFlightRoute.length < 2;
        }

        // Update layover duration
        function updateLayoverDuration(index, value) {
            multiFlightLayovers[index] = parseInt(value);
        }
        // Make function global for inline onclick
        window.updateLayoverDuration = updateLayoverDuration;
        window.removeMultiFlightStop = removeMultiFlightStop;

        // Confirm route and book
        document.getElementById('confirm-route-btn').addEventListener('click', () => {
            if (multiFlightRoute.length < 2) return;

            // Set departure and arrival
            departureAirport = multiFlightRoute[0];
            arrivalAirport = multiFlightRoute[multiFlightRoute.length - 1];
            selectedDestination = arrivalAirport;

            // Store layovers for multi-leg flight
            layoverAirports = multiFlightRoute.slice(1, -1); // Middle stops

            // Hide multi-flight screen, show boarding pass
            multiFlightScreen.classList.remove('active');
            boardingPass.classList.add('active');

            // Update flight path with multi-leg arcs
            updateLayoverFlightPath();

            // Show destination pin
            showDestinationPin(arrivalAirport);

            // Update boarding pass details
            document.getElementById('pass-from-code').textContent = departureAirport.iata || '---';
            document.getElementById('pass-from-city').textContent = departureAirport.city || departureAirport.name || '';
            document.getElementById('pass-to-code').textContent = arrivalAirport.iata;
            document.getElementById('pass-to-city').textContent = arrivalAirport.city || arrivalAirport.name || '';

            // Random gate and seat
            const gates = ['A', 'B', 'C', 'D', 'E', 'F'];
            const gate = gates[Math.floor(Math.random() * gates.length)] + Math.floor(Math.random() * 20 + 1);
            const seat = String.fromCharCode(65 + Math.floor(Math.random() * 6)) + Math.floor(Math.random() * 30 + 1);
            const focus = selectedFocusType;
            const flightNumber = 'Flight FF-' + Math.floor(Math.random() * 9000 + 1000);
            const dateStr = new Date().toISOString().split('T')[0].replace(/-/g, '/');

            document.getElementById('pass-gate').textContent = gate;
            document.getElementById('pass-seat').textContent = seat;
            document.getElementById('pass-focus').textContent = focus + ' (Multi-Flight)';

            // Calculate total distance
            let totalDist = 0;
            for (let i = 0; i < multiFlightRoute.length - 1; i++) {
                totalDist += haversineDistance(multiFlightRoute[i].lat, multiFlightRoute[i].lon,
                    multiFlightRoute[i + 1].lat, multiFlightRoute[i + 1].lon);
            }
            document.getElementById('pass-distance').textContent = Math.round(totalDist) + 'Km';
            document.getElementById('pass-date').textContent = dateStr;
            document.getElementById('pass-flight-number').textContent = flightNumber;

            // Store flight data
            currentFlightData = {
                fromCode: departureAirport.iata || '---',
                fromCity: departureAirport.city || departureAirport.name || '',
                toCode: arrivalAirport.iata,
                toCity: arrivalAirport.city || arrivalAirport.name || '',
                gate: gate,
                seat: seat,
                focus: focus + ' (Multi-Flight)',
                distance: Math.round(totalDist),
                duration: formatDuration(calculateFlightDuration(totalDist)),
                date: dateStr,
                flightNumber: flightNumber,
                status: 'cancelled'
            };

            // Show globe
            document.getElementById('globe-container').style.opacity = '1';
        });

        // ============ SESSION NOTES ============
        const notesModal = document.getElementById('notes-modal');
        const notesModalClose = document.getElementById('notes-modal-close');
        const notesBtn = document.getElementById('notes-btn');
        const notesTextarea = document.getElementById('notes-textarea');

        function openNotesModal() {
            // Load existing notes if any
            if (currentFlightData && currentFlightData.notes) {
                notesTextarea.value = currentFlightData.notes;
            } else {
                notesTextarea.value = '';
            }
            notesModal.classList.add('active');
            notesTextarea.focus();
        }

        function closeNotesModal() {
            // Auto-save notes to current flight data
            if (currentFlightData) {
                currentFlightData.notes = notesTextarea.value;
            }
            notesModal.classList.remove('active');
        }

        notesBtn?.addEventListener('click', openNotesModal);
        notesModalClose?.addEventListener('click', closeNotesModal);

        // Also save on textarea blur
        notesTextarea?.addEventListener('blur', () => {
            if (currentFlightData) {
                currentFlightData.notes = notesTextarea.value;
            }
        });

        // End flight button
        endFlightBtn.addEventListener('click', () => {
            // Save as cancelled to history
            if (currentFlightData) {
                currentFlightData.status = 'cancelled';
                addFlightToHistory(currentFlightData);
                currentFlightData = null;
            }

            resetFlight();
            inflightBar.classList.remove('active');
            inflightControlsEl.classList.remove('active');

            // Reset to initial state
            startJourneyBtn.style.display = 'block';
            menuBtn.style.display = 'flex';
            selectedDestination = null;
            departureAirport = null;
            arrivalAirport = null;
            bookSingleBtn.disabled = true;
            bookMultiBtn.disabled = true;
            document.querySelectorAll('.airport-card').forEach(c => c.classList.remove('selected'));
        });

        // Update in-flight bar during flight
        function updateInflightBar(progress) {
            if (!window.currentFlightDuration) return;

            const remainingMs = Math.max(0, window.currentFlightDuration * (1 - progress));
            const remainingMin = Math.round(remainingMs / 60000);

            const totalDistance = selectedDestination ? selectedDestination.distance : 0;
            let remainingDist = Math.round(totalDistance * (1 - progress));

            // Update time
            document.getElementById('inflight-time').textContent = remainingMin;

            // Update distance with unit conversion
            if (useMetric) {
                document.getElementById('inflight-distance').textContent = remainingDist;
                document.querySelector('#inflight-bar .inflight-stat:nth-child(3) .unit').textContent = 'Km';
            } else {
                // Convert km to miles
                const miles = Math.round(remainingDist * 0.621371);
                document.getElementById('inflight-distance').textContent = miles;
                document.querySelector('#inflight-bar .inflight-stat:nth-child(3) .unit').textContent = 'mi';
            }

            // Update altitude display (convert from globe units)
            // currentAltitude: 1.0 = ground, 3.0 = cruise altitude
            const altitudeInFeet = Math.round((currentAltitude - 1.0) * 17500); // ~35,000 ft at cruise
            if (useMetric) {
                // Convert feet to meters
                const meters = Math.round(altitudeInFeet * 0.3048);
                document.getElementById('inflight-altitude').textContent = Math.max(0, meters).toLocaleString();
                document.querySelector('#inflight-bar .inflight-stat:nth-child(2) .unit').textContent = 'm';
            } else {
                document.getElementById('inflight-altitude').textContent = Math.max(0, altitudeInFeet).toLocaleString();
                document.querySelector('#inflight-bar .inflight-stat:nth-child(2) .unit').textContent = 'ft';
            }

            // When flight completes
            if (progress >= 1) {
                // Save as completed to history
                if (currentFlightData) {
                    currentFlightData.status = 'completed';
                    addFlightToHistory(currentFlightData);
                    currentFlightData = null;
                }

                setTimeout(() => {
                    inflightBar.classList.remove('active');
                    inflightControlsEl.classList.remove('active');
                    startJourneyBtn.style.display = 'block';
                    menuBtn.style.display = 'flex';

                    // Reset state
                    selectedDestination = null;
                    departureAirport = null;
                    arrivalAirport = null;
                    bookSingleBtn.disabled = true;
                    bookMultiBtn.disabled = true;
                }, 2000);
            }
        }

        // Hook into animateFlight to update in-flight bar
        const originalAnimateFlightNew = animateFlight;
        animateFlight = function () {
            originalAnimateFlightNew();
            if (flightProgress >= 0 && inflightBar.classList.contains('active')) {
                updateInflightBar(flightProgress);
            }
        };

        // ============ INITIALIZATION ============
        async function init() {
            createStarfield();
            createSun();
            createClouds();
            airplane = await createAirplane();

            // Create destination pin marker
            destinationPin = createDestinationPin();
            scene.add(destinationPin);

            // Add lighting for airplane
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(1, 1, 1);
            scene.add(directionalLight);

            loadCountries();
            loadAirports();
        }

        // ============ ULTRA-REALISTIC WINDOW VIEW 3D SCENE ============
        let windowScene, windowCamera, windowRenderer;
        let windowClouds = [];
        let windowTerrain = null;
        let windowAnimationId = null;
        let windowViewActive = false;
        let windowInitialized = false;

        function initWindowView() {
            if (windowInitialized) return;

            const container = document.getElementById('window-scene');
            if (!container) return;

            // Create scene with advanced atmospheric fog
            windowScene = new THREE.Scene();
            windowScene.fog = new THREE.FogExp2(0x8CB4D9, 0.00004);

            // Camera - Side View (looking out the side window)
            windowCamera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 1, 80000);
            windowCamera.position.set(0, 3000, 0);
            windowCamera.lookAt(0, 2000, -15000);

            // High-performance renderer with enhanced settings
            windowRenderer = new THREE.WebGLRenderer({
                antialias: true,
                alpha: false,
                powerPreference: "high-performance",
                stencil: false
            });
            windowRenderer.setSize(window.innerWidth, window.innerHeight);
            windowRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            windowRenderer.setClearColor(0x6BA3D6);
            windowRenderer.toneMapping = THREE.ACESFilmicToneMapping;
            windowRenderer.toneMappingExposure = 1.4;
            windowRenderer.outputColorSpace = THREE.SRGBColorSpace;
            container.appendChild(windowRenderer.domElement);

            // Premium Lighting Setup
            setupPremiumLighting();

            // Load all textures and create scene
            const textureLoader = new THREE.TextureLoader();
            window.loadedTextures = {};
            const texturePromises = [];

            // Load photorealistic terrain texture
            texturePromises.push(
                new Promise((resolve) => {
                    textureLoader.load('assets/aerial_terrain.png', (tex) => {
                        tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
                        tex.repeat.set(4, 4);
                        tex.anisotropy = windowRenderer.capabilities.getMaxAnisotropy();
                        tex.generateMipmaps = true;
                        tex.minFilter = THREE.LinearMipmapLinearFilter;
                        tex.magFilter = THREE.LinearFilter;
                        window.loadedTextures.terrain = tex;
                        resolve();
                    }, undefined, resolve);
                })
            );

            // Load original cloud alpha textures
            for (let i = 1; i <= 10; i++) {
                const num = i.toString().padStart(2, '0');
                texturePromises.push(
                    new Promise((resolve) => {
                        textureLoader.load(`assets/clouds/FX_CloudAlpha${num}.png`, (tex) => {
                            if (!window.loadedTextures.cloudAlphas) window.loadedTextures.cloudAlphas = [];
                            window.loadedTextures.cloudAlphas.push(tex);
                            resolve();
                        }, undefined, resolve);
                    })
                );
            }

            // Load new photorealistic cloud textures
            texturePromises.push(
                new Promise((resolve) => {
                    textureLoader.load('assets/clouds/fluffy_cloud_1.png', (tex) => {
                        window.loadedTextures.fluffyCloud = tex;
                        resolve();
                    }, undefined, resolve);
                })
            );

            texturePromises.push(
                new Promise((resolve) => {
                    textureLoader.load('assets/clouds/cloud_tower.png', (tex) => {
                        window.loadedTextures.cloudTower = tex;
                        resolve();
                    }, undefined, resolve);
                })
            );

            texturePromises.push(
                new Promise((resolve) => {
                    textureLoader.load('assets/clouds/sea_of_clouds.png', (tex) => {
                        tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
                        window.loadedTextures.seaOfClouds = tex;
                        resolve();
                    }, undefined, resolve);
                })
            );

            texturePromises.push(
                new Promise((resolve) => {
                    textureLoader.load('assets/clouds/wispy_cirrus.png', (tex) => {
                        window.loadedTextures.wispyCirrus = tex;
                        resolve();
                    }, undefined, resolve);
                })
            );

            Promise.all(texturePromises).then(() => {
                createPhotorealisticSky();
                createSeaOfCloudsCarpet();
                createVolumetricCloudLayers();
                createPhotorealisticTerrain();
                createAtmosphericSun();
                createGodRays();

                // Start animation if window view is already active (handles async loading)
                if (windowViewActive && !windowAnimationId) {
                    animateWindowView();
                }
            });

            windowInitialized = true;
        }

        function setupPremiumLighting() {
            const ambientLight = new THREE.AmbientLight(0xC4D8E8, 0.35);
            windowScene.add(ambientLight);
            const hemiLight = new THREE.HemisphereLight(0x87CEEB, 0x8B6914, 0.5);
            hemiLight.position.set(0, 50, 0);
            windowScene.add(hemiLight);
            const sunLight = new THREE.DirectionalLight(0xFFE4B5, 2.5);
            sunLight.position.set(8000, 10000, -5000);
            windowScene.add(sunLight);
            const skyFill = new THREE.DirectionalLight(0x87CEEB, 0.4);
            skyFill.position.set(-5000, 8000, 2000);
            windowScene.add(skyFill);
            const rimLight = new THREE.DirectionalLight(0xFFD700, 0.6);
            rimLight.position.set(-4000, 3000, 8000);
            windowScene.add(rimLight);
            const backLight = new THREE.DirectionalLight(0xE8D4B8, 0.3);
            backLight.position.set(0, 1000, 10000);
            windowScene.add(backLight);
        }

        function createPhotorealisticSky() {
            const skyGeo = new THREE.SphereGeometry(60000, 64, 64);
            const skyMat = new THREE.ShaderMaterial({
                uniforms: {
                    topColor: { value: new THREE.Color(0x0A3D7A) },
                    midColor: { value: new THREE.Color(0x4A90D9) },
                    horizonColor: { value: new THREE.Color(0xB8D4E8) },
                    hazeTint: { value: new THREE.Color(0xFFE4C4) },
                    sunColor: { value: new THREE.Color(0xFFFAF0) },
                    sunPosition: { value: new THREE.Vector3(0.6, 0.25, -0.75).normalize() },
                    hazeIntensity: { value: 0.4 }
                },
                vertexShader: `
                    varying vec3 vWorldPosition;
                    void main() {
                        vec4 worldPosition = modelMatrix * vec4(position, 1.0);
                        vWorldPosition = worldPosition.xyz;
                        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                    }
                `,
                fragmentShader: `
                    uniform vec3 topColor;
                    uniform vec3 midColor;
                    uniform vec3 horizonColor;
                    uniform vec3 hazeTint;
                    uniform vec3 sunColor;
                    uniform vec3 sunPosition;
                    uniform float hazeIntensity;
                    varying vec3 vWorldPosition;
                    
                    void main() {
                        float h = normalize(vWorldPosition).y;
                        vec3 color;
                        if (h > 0.3) { color = mix(midColor, topColor, smoothstep(0.3, 0.9, h)); }
                        else if (h > 0.0) { color = mix(horizonColor, midColor, smoothstep(0.0, 0.3, h)); }
                        else { color = mix(hazeTint, horizonColor, smoothstep(-0.2, 0.0, h)); }
                        float hazeAmount = 1.0 - smoothstep(-0.1, 0.3, h);
                        color = mix(color, hazeTint, hazeAmount * hazeIntensity);
                        vec3 dir = normalize(vWorldPosition);
                        float sunDot = max(dot(dir, sunPosition), 0.0);
                        float sunCore = pow(sunDot, 256.0) * 4.0;
                        float sunGlow = pow(sunDot, 32.0) * 1.2;
                        float sunHalo = pow(sunDot, 4.0) * 0.4;
                        float sunScatter = pow(sunDot, 2.0) * 0.15;
                        color = mix(color, sunColor, clamp(sunCore + sunGlow + sunHalo + sunScatter, 0.0, 1.0));
                        gl_FragColor = vec4(color, 1.0);
                    }
                `,
                side: THREE.BackSide
            });
            const sky = new THREE.Mesh(skyGeo, skyMat);
            windowScene.add(sky);
            window.skyMesh = sky;
        }

        function createSeaOfCloudsCarpet() {
            if (!window.loadedTextures.seaOfClouds) return;
            const carpetGeometry = new THREE.PlaneGeometry(80000, 80000, 64, 64);
            carpetGeometry.rotateX(-Math.PI / 2);
            const vertices = carpetGeometry.attributes.position.array;
            for (let i = 0; i < vertices.length; i += 3) {
                const x = vertices[i]; const z = vertices[i + 2];
                vertices[i + 1] = Math.sin(x * 0.0002) * Math.cos(z * 0.0002) * 200 + Math.sin(x * 0.0005 + z * 0.0003) * 100;
            }
            carpetGeometry.computeVertexNormals();
            const carpetMaterial = new THREE.ShaderMaterial({
                uniforms: { cloudTexture: { value: window.loadedTextures.seaOfClouds }, time: { value: 0 }, fogColor: { value: new THREE.Color(0xB8D4E8) }, fogNear: { value: 8000 }, fogFar: { value: 50000 } },
                vertexShader: `varying vec2 vUv; varying float vFogDepth; void main() { vUv = uv; vec4 mvPosition = modelViewMatrix * vec4(position, 1.0); vFogDepth = -mvPosition.z; gl_Position = projectionMatrix * mvPosition; }`,
                fragmentShader: `uniform sampler2D cloudTexture; uniform float time; uniform vec3 fogColor; uniform float fogNear; uniform float fogFar; varying vec2 vUv; varying float vFogDepth; void main() { vec2 uv = vUv * 3.0; uv.x += time * 0.01; vec4 cloudColor = texture2D(cloudTexture, uv); cloudColor.rgb = pow(cloudColor.rgb, vec3(0.9)); cloudColor.rgb *= 1.2; float fogFactor = smoothstep(fogNear, fogFar, vFogDepth); cloudColor.rgb = mix(cloudColor.rgb, fogColor, fogFactor * 0.7); float edgeFade = smoothstep(0.0, 0.15, vUv.x) * smoothstep(1.0, 0.85, vUv.x) * smoothstep(0.0, 0.15, vUv.y) * smoothstep(1.0, 0.85, vUv.y); gl_FragColor = vec4(cloudColor.rgb, edgeFade * 0.95); }`,
                transparent: true, depthWrite: false, side: THREE.DoubleSide
            });
            const cloudCarpet = new THREE.Mesh(carpetGeometry, carpetMaterial);
            cloudCarpet.position.set(0, -1200, -20000);
            windowScene.add(cloudCarpet);
            window.cloudCarpet = cloudCarpet;
        }

        function createVolumetricCloudLayers() {
            const textures = window.loadedTextures.cloudAlphas || [];
            const fluffyTex = window.loadedTextures.fluffyCloud;
            const towerTex = window.loadedTextures.cloudTower;
            const cirrusTex = window.loadedTextures.wispyCirrus;

            // Layer 1: Distant fluffy cumulus clouds
            for (let i = 0; i < 60; i++) {
                const tex = textures.length > 0 ? textures[Math.floor(Math.random() * textures.length)] : null;
                if (!tex) continue;
                const spriteMat = new THREE.SpriteMaterial({ map: tex, transparent: true, blending: THREE.AdditiveBlending, opacity: 0.85 + Math.random() * 0.15, depthWrite: false, fog: true, color: new THREE.Color(0xFFFFFF) });
                const sprite = new THREE.Sprite(spriteMat);
                const scale = 3000 + Math.random() * 4000;
                sprite.scale.set(scale, scale * 0.55, 1);
                sprite.position.set((Math.random() - 0.5) * 40000, -800 + Math.random() * 600, -Math.random() * 25000 - 4000);
                windowScene.add(sprite);
                windowClouds.push({ mesh: sprite, speed: 6 + Math.random() * 3, type: 'far_cumulus', baseY: sprite.position.y, phase: Math.random() * Math.PI * 2 });
            }

            // Layer 2: Mid-level dramatic clouds
            for (let i = 0; i < 35; i++) {
                const tex = textures.length > 0 ? textures[Math.floor(Math.random() * textures.length)] : null;
                if (!tex) continue;
                const spriteMat = new THREE.SpriteMaterial({ map: tex, transparent: true, blending: THREE.AdditiveBlending, opacity: 0.9, depthWrite: false, fog: true, color: new THREE.Color(0xFFFFF8) });
                const sprite = new THREE.Sprite(spriteMat);
                const scale = 2000 + Math.random() * 3000;
                sprite.scale.set(scale, scale * 0.6, 1);
                sprite.position.set((Math.random() - 0.5) * 35000, 600 + Math.random() * 1400, -Math.random() * 15000 - 2500);
                windowScene.add(sprite);
                windowClouds.push({ mesh: sprite, speed: 12 + Math.random() * 8, type: 'mid_dramatic', baseY: sprite.position.y, phase: Math.random() * Math.PI * 2 });
            }

            // Layer 3: Close passing clouds
            for (let i = 0; i < 25; i++) {
                const tex = textures.length > 0 ? textures[Math.floor(Math.random() * textures.length)] : null;
                if (!tex) continue;
                const spriteMat = new THREE.SpriteMaterial({ map: tex, transparent: true, blending: THREE.AdditiveBlending, opacity: 0.92, depthWrite: false, fog: true, color: new THREE.Color(0xFFFFFF) });
                const sprite = new THREE.Sprite(spriteMat);
                const scale = 1000 + Math.random() * 1500;
                sprite.scale.set(scale, scale * 0.65, 1);
                sprite.position.set((Math.random() - 0.5) * 20000, 1800 + Math.random() * 1200, -Math.random() * 6000 - 600);
                windowScene.add(sprite);
                windowClouds.push({ mesh: sprite, speed: 35 + Math.random() * 25, type: 'near_fast', baseY: sprite.position.y, phase: Math.random() * Math.PI * 2 });
            }

            // Layer 4: Cirrus wisps
            if (cirrusTex) {
                for (let i = 0; i < 8; i++) {
                    const spriteMat = new THREE.SpriteMaterial({ map: cirrusTex, transparent: true, blending: THREE.AdditiveBlending, opacity: 0.4 + Math.random() * 0.3, depthWrite: false, fog: false });
                    const sprite = new THREE.Sprite(spriteMat);
                    const scale = 8000 + Math.random() * 6000;
                    sprite.scale.set(scale, scale * 0.4, 1);
                    sprite.position.set((Math.random() - 0.5) * 50000, 5000 + Math.random() * 3000, -Math.random() * 30000 - 10000);
                    windowScene.add(sprite);
                    windowClouds.push({ mesh: sprite, speed: 2 + Math.random() * 2, type: 'cirrus', baseY: sprite.position.y, phase: Math.random() * Math.PI * 2 });
                }
            }

            // Photorealistic fluffy clouds
            if (fluffyTex) {
                for (let i = 0; i < 10; i++) {
                    const spriteMat = new THREE.SpriteMaterial({ map: fluffyTex, transparent: true, blending: THREE.AdditiveBlending, opacity: 0.85, depthWrite: false, fog: true });
                    const sprite = new THREE.Sprite(spriteMat);
                    const scale = 2500 + Math.random() * 2500;
                    sprite.scale.set(scale, scale * 0.8, 1);
                    sprite.position.set((Math.random() - 0.5) * 35000, 200 + Math.random() * 1500, -Math.random() * 18000 - 3000);
                    windowScene.add(sprite);
                    windowClouds.push({ mesh: sprite, speed: 10 + Math.random() * 6, type: 'fluffy_photo', baseY: sprite.position.y, phase: Math.random() * Math.PI * 2 });
                }
            }

            // Towering cumulonimbus
            if (towerTex) {
                for (let i = 0; i < 3; i++) {
                    const spriteMat = new THREE.SpriteMaterial({ map: towerTex, transparent: true, blending: THREE.AdditiveBlending, opacity: 0.75, depthWrite: false, fog: true });
                    const sprite = new THREE.Sprite(spriteMat);
                    const scale = 12000 + Math.random() * 8000;
                    sprite.scale.set(scale, scale, 1);
                    sprite.position.set((Math.random() - 0.5) * 60000, -2000 + Math.random() * 1000, -35000 - Math.random() * 15000);
                    windowScene.add(sprite);
                    windowClouds.push({ mesh: sprite, speed: 3 + Math.random() * 2, type: 'tower', baseY: sprite.position.y, phase: Math.random() * Math.PI * 2 });
                }
            }
        }

        function createPhotorealisticTerrain() {
            const tex = window.loadedTextures.terrain;
            if (!tex) return;
            const geometry = new THREE.PlaneGeometry(80000, 80000, 300, 300);
            geometry.rotateX(-Math.PI / 2);
            const vertices = geometry.attributes.position.array;
            for (let i = 0; i < vertices.length; i += 3) {
                const x = vertices[i]; const z = vertices[i + 2];
                const elevation = Math.sin(x * 0.00015) * Math.cos(z * 0.00015) * 2500 + Math.sin(x * 0.0004 + 0.3) * Math.cos(z * 0.0004) * 1200 + Math.sin(x * 0.001) * Math.cos(z * 0.001 + 0.5) * 500 + Math.sin(x * 0.003) * Math.cos(z * 0.003) * 150 + Math.sin(x * 0.01) * 40;
                vertices[i + 1] = elevation - 10000;
            }
            geometry.computeVertexNormals();
            const material = new THREE.ShaderMaterial({
                uniforms: { terrainTexture: { value: tex }, fogColor: { value: new THREE.Color(0xB8D4E8) }, fogNear: { value: 15000 }, fogFar: { value: 55000 }, lightDirection: { value: new THREE.Vector3(0.5, 0.6, -0.5).normalize() }, ambientStrength: { value: 0.4 } },
                vertexShader: `varying vec2 vUv; varying vec3 vNormal; varying float vFogDepth; varying vec3 vPosition; void main() { vUv = uv; vNormal = normalize(normalMatrix * normal); vPosition = position; vec4 mvPosition = modelViewMatrix * vec4(position, 1.0); vFogDepth = -mvPosition.z; gl_Position = projectionMatrix * mvPosition; }`,
                fragmentShader: `uniform sampler2D terrainTexture; uniform vec3 fogColor; uniform float fogNear; uniform float fogFar; uniform vec3 lightDirection; uniform float ambientStrength; varying vec2 vUv; varying vec3 vNormal; varying float vFogDepth; varying vec3 vPosition; void main() { vec4 texColor = texture2D(terrainTexture, vUv * 4.0); float diffuse = max(dot(vNormal, lightDirection), 0.0); float lighting = ambientStrength + diffuse * (1.0 - ambientStrength); float heightFactor = smoothstep(-11000.0, -8000.0, vPosition.y); texColor.rgb *= 0.85 + heightFactor * 0.3; vec3 litColor = texColor.rgb * lighting; float fogFactor = smoothstep(fogNear, fogFar, vFogDepth); litColor = mix(litColor, fogColor, fogFactor * 0.85); gl_FragColor = vec4(litColor, 1.0); }`,
                side: THREE.FrontSide
            });
            windowTerrain = new THREE.Mesh(geometry, material);
            windowTerrain.position.z = -20000;
            windowScene.add(windowTerrain);
        }

        function createAtmosphericSun() {
            const sunCanvas = document.createElement('canvas');
            sunCanvas.width = 512; sunCanvas.height = 512;
            const ctx = sunCanvas.getContext('2d');
            const gradient = ctx.createRadialGradient(256, 256, 0, 256, 256, 256);
            gradient.addColorStop(0, 'rgba(255, 255, 250, 1)');
            gradient.addColorStop(0.02, 'rgba(255, 255, 240, 1)');
            gradient.addColorStop(0.05, 'rgba(255, 250, 220, 0.95)');
            gradient.addColorStop(0.12, 'rgba(255, 235, 180, 0.7)');
            gradient.addColorStop(0.25, 'rgba(255, 210, 140, 0.4)');
            gradient.addColorStop(0.45, 'rgba(255, 180, 100, 0.15)');
            gradient.addColorStop(0.7, 'rgba(255, 150, 80, 0.05)');
            gradient.addColorStop(1, 'rgba(255, 120, 50, 0)');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 512, 512);
            const sunTexture = new THREE.CanvasTexture(sunCanvas);
            const sunMat = new THREE.SpriteMaterial({ map: sunTexture, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false });
            const sun = new THREE.Sprite(sunMat);
            sun.scale.set(12000, 12000, 1);
            sun.position.set(20000, 14000, -35000);
            windowScene.add(sun);

            const flareCanvas = document.createElement('canvas');
            flareCanvas.width = 256; flareCanvas.height = 256;
            const flareCtx = flareCanvas.getContext('2d');
            const flareGradient = flareCtx.createRadialGradient(128, 128, 0, 128, 128, 128);
            flareGradient.addColorStop(0, 'rgba(255, 255, 255, 0.3)');
            flareGradient.addColorStop(0.3, 'rgba(255, 240, 200, 0.15)');
            flareGradient.addColorStop(0.6, 'rgba(255, 200, 150, 0.05)');
            flareGradient.addColorStop(1, 'rgba(255, 150, 100, 0)');
            flareCtx.fillStyle = flareGradient;
            flareCtx.fillRect(0, 0, 256, 256);
            const flareTexture = new THREE.CanvasTexture(flareCanvas);
            const flareMat = new THREE.SpriteMaterial({ map: flareTexture, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, opacity: 0.5 });
            const flare = new THREE.Sprite(flareMat);
            flare.scale.set(20000, 20000, 1);
            flare.position.set(20000, 14000, -35000);
            windowScene.add(flare);
        }

        function createGodRays() {
            const rayCanvas = document.createElement('canvas');
            rayCanvas.width = 512; rayCanvas.height = 256;
            const ctx = rayCanvas.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 512, 256);
            gradient.addColorStop(0, 'rgba(255, 250, 230, 0.2)');
            gradient.addColorStop(0.5, 'rgba(255, 240, 200, 0.08)');
            gradient.addColorStop(1, 'rgba(255, 220, 180, 0)');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 512, 256);
            const rayTexture = new THREE.CanvasTexture(rayCanvas);
            for (let i = 0; i < 5; i++) {
                const rayMat = new THREE.SpriteMaterial({ map: rayTexture, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, opacity: 0.15 + Math.random() * 0.1, rotation: (Math.random() - 0.5) * 0.5 });
                const ray = new THREE.Sprite(rayMat);
                ray.scale.set(25000, 8000, 1);
                ray.position.set(15000 + Math.random() * 10000, 10000 + Math.random() * 6000, -30000 - Math.random() * 10000);
                windowScene.add(ray);
            }
        }

        function animateWindowView() {
            if (!windowViewActive) return;
            windowAnimationId = requestAnimationFrame(animateWindowView);
            const time = Date.now() * 0.001;

            windowClouds.forEach(item => {
                item.mesh.position.x -= item.speed;
                if (item.baseY !== undefined) {
                    const driftAmount = item.type === 'cirrus' ? 60 : item.type === 'tower' ? 20 : item.type === 'near_fast' ? 40 : 30;
                    item.mesh.position.y = item.baseY + Math.sin(time * 0.5 + item.phase) * driftAmount + Math.sin(time * 0.2 + item.phase * 2) * (driftAmount * 0.5);
                }
                let wrapDistance = 20000;
                if (item.type === 'far_cumulus') wrapDistance = 40000;
                else if (item.type === 'mid_dramatic') wrapDistance = 35000;
                else if (item.type === 'fluffy_photo') wrapDistance = 35000;
                else if (item.type === 'near_fast') wrapDistance = 20000;
                else if (item.type === 'cirrus') wrapDistance = 50000;
                else if (item.type === 'tower') wrapDistance = 60000;

                if (item.mesh.position.x < -wrapDistance) {
                    item.mesh.position.x = wrapDistance;
                    if (item.type === 'far_cumulus') { item.mesh.position.z = -Math.random() * 25000 - 4000; item.baseY = -800 + Math.random() * 600; }
                    else if (item.type === 'mid_dramatic') { item.mesh.position.z = -Math.random() * 15000 - 2500; item.baseY = 600 + Math.random() * 1400; }
                    else if (item.type === 'near_fast') { item.mesh.position.z = -Math.random() * 6000 - 600; item.baseY = 1800 + Math.random() * 1200; }
                    else if (item.type === 'fluffy_photo') { item.mesh.position.z = -Math.random() * 18000 - 3000; item.baseY = 200 + Math.random() * 1500; }
                    else if (item.type === 'cirrus') { item.mesh.position.z = -Math.random() * 30000 - 10000; }
                    else if (item.type === 'tower') { item.mesh.position.z = -35000 - Math.random() * 15000; }
                }
            });

            if (window.cloudCarpet && window.cloudCarpet.material.uniforms) {
                window.cloudCarpet.material.uniforms.time.value = time;
            }
            if (windowTerrain) {
                windowTerrain.position.x -= 4;
                if (windowTerrain.position.x < -25000) { windowTerrain.position.x = 0; }
            }
            windowCamera.position.y = 3000 + Math.sin(time * 0.3) * 20;
            windowCamera.rotation.z = Math.sin(time * 0.15) * 0.003;
            windowRenderer.render(windowScene, windowCamera);
        }


        function openWindowView() {
            if (!windowInitialized) {
                initWindowView();
            }
            windowViewActive = true;
            document.getElementById('window-view-container').classList.add('active');
            document.getElementById('window-view-btn').classList.add('active');

            // Handle resize
            if (windowRenderer && windowCamera) {
                windowRenderer.setSize(window.innerWidth, window.innerHeight);
                windowCamera.aspect = window.innerWidth / window.innerHeight;
                windowCamera.updateProjectionMatrix();
            }

            animateWindowView();
        }

        function closeWindowView() {
            windowViewActive = false;
            document.getElementById('window-view-container').classList.remove('active');
            document.getElementById('window-view-btn').classList.remove('active');
            if (windowAnimationId) {
                cancelAnimationFrame(windowAnimationId);
                windowAnimationId = null;
            }
        }

        // Window view button handlers
        document.getElementById('window-view-btn').addEventListener('click', () => {
            if (windowViewActive) {
                closeWindowView();
            } else {
                openWindowView();
            }
        });

        document.getElementById('window-close-btn').addEventListener('click', closeWindowView);

        // Show window view button during flight
        function showWindowViewButton() {
            document.getElementById('window-view-btn').style.display = 'flex';
        }

        function hideWindowViewButton() {
            document.getElementById('window-view-btn').style.display = 'none';
            closeWindowView();
        }

        // Handle window resize for window view
        window.addEventListener('resize', () => {
            if (windowViewActive && windowRenderer && windowCamera) {
                windowRenderer.setSize(window.innerWidth, window.innerHeight);
                windowCamera.aspect = window.innerWidth / window.innerHeight;
                windowCamera.updateProjectionMatrix();
            }
        });

        init();

        // Handle resize
        window.addEventListener('resize', () => {
            globe.width(window.innerWidth).height(window.innerHeight);
        });
    </script>
</body>

</html>